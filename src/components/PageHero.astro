---
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Doodle from './Doodle.astro';

interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  lead: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  imageTone?: 'pink' | 'sage' | 'gold' | 'cream';
  imagePosition?: string;
  badge?: string;
  breadcrumb?: string;
  class?: string;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  accent,
  lead,
  image,
  imageAlt = '',
  imageTone = 'pink',
  imagePosition = '50% center',
  badge,
  breadcrumb,
  class: className = '',
  compact = false,
} = Astro.props;

const hasVisual = Astro.slots.has('visual');
const hasImage = Boolean(image);
---

<section class:list={['page-hero grid-lines', compact && 'page-hero--compact', className]}>
  <div class="page-hero__blob blob blob--pink"></div>
  <Doodle type="butterfly" class="page-hero__doodle page-hero__doodle--butterfly" />
  <Doodle type="sparkle" class="page-hero__doodle page-hero__doodle--sparkle" />

  <div class:list={['container page-hero__inner', !hasVisual && !hasImage && 'page-hero__inner--single']}>
    <div class="page-hero__copy">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">{breadcrumb ?? title}</li>
        </ol>
      </nav>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>
        {title}{accent && <> <em>{accent}</em></>}
      </h1>
      <p class="lead">{lead}</p>
      {badge && <span class="pill pill--pink page-hero__badge">{badge}</span>}
      <slot />
    </div>

    {
      hasVisual && (
        <div class="page-hero__visual page-hero__visual--art">
          <div class:list={['page-hero__visual-bg', `page-hero__visual-bg--${imageTone}`]} />
          <slot name="visual" />
        </div>
      )
    }

    {
      !hasVisual && image && (
        <div class="page-hero__visual">
          <div class:list={['page-hero__visual-bg', `page-hero__visual-bg--${imageTone}`]} />
          <div class="page-hero__frame arch">
            <img
              src={typeof image === 'string' ? image : image.src}
              alt={imageAlt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style={`object-position: ${imagePosition}`}
            />
          </div>
          <div class="page-hero__stamp" aria-hidden="true">
            <Icon name="heart" size={16} />
            <span>Care that sees the whole child</span>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
.page-hero {
    position: relative;
    padding-block: clamp(2.75rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6.5rem);
    overflow: clip;
    background: var(--cream);
  }
.page-hero--compact {
    padding-block: clamp(2.5rem, 4vw, 3.75rem) clamp(2.5rem, 5vw, 4rem);
  }
.page-hero__blob {
    width: clamp(300px, 46vw, 660px);
    height: clamp(260px, 40vw, 520px);
    top: -32%;
    right: -12%;
    opacity: 0.65;
  }
.page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.72fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
  }
.page-hero__inner--single {
    grid-template-columns: minmax(0, 860px);
    justify-content: center;
    text-align: center;
    justify-items: center;
  }
.page-hero__copy {
    display: grid;
    justify-items: start;
    gap: 1.15rem;
    max-width: 700px;
  }
.page-hero__inner--single .page-hero__copy {
    justify-items: center;
  }
.breadcrumbs {
    margin-bottom: 0.25rem;
  }
.breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.68rem;
  }
.breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
.breadcrumbs li:not(:last-child)::after {
    content: '/';
    color: rgba(45, 22, 116, 0.3);
  }
.breadcrumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    text-decoration: none;
  }
.breadcrumbs a:hover {
    color: var(--pink-deep);
  }
.brand h1, .page-hero h1 {
    max-width: 17ch;
  }
.page-hero__inner--single h1 {
    max-width: 20ch;
  }
.page-hero h1 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.page-hero .lead {
    max-width: 52ch;
  }
.page-hero__badge {
    margin-top: 0.25rem;
  }
.page-hero__visual {
    position: relative;
    isolation: isolate;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }
.page-hero__visual-bg {
    position: absolute;
    inset: 8% -5% -5% 10%;
    z-index: -1;
    border-radius: 48% 52% 44% 56% / 40% 38% 62% 60%;
    background: var(--pink-soft);
    transform: rotate(-3deg);
  }
.page-hero__visual-bg--sage {
    background: var(--sage);
  }
.page-hero__visual-bg--gold {
    background: var(--gold-soft);
  }
.page-hero__visual-bg--cream {
    background: var(--cream-deep);
  }
.page-hero__frame {
    aspect-ratio: 4 / 5;
    background: var(--white);
    box-shadow: var(--shadow);
  }
.page-hero__visual--art {
    aspect-ratio: 4 / 5;
  }
.page-hero__visual--art :global(.art-panel) {
    position: relative;
    z-index: 1;
    border: 6px solid var(--white);
    border-radius: 260px 260px 30px 30px;
    box-shadow: var(--shadow);
  }
.page-hero__visual--art::after {
    content: '';
    position: absolute;
    z-index: 2;
    right: -1.15rem;
    bottom: -1.15rem;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 14px 30px -16px rgba(45, 22, 116, 0.5);
    opacity: 0.9;
  }
.page-hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
.page-hero__stamp {
    position: absolute;
    left: -1rem;
    bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 210px;
    padding: 0.65rem 0.9rem;
    border-radius: 14px;
    background: var(--white);
    box-shadow: var(--shadow);
    color: var(--purple);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.4;
    transform: rotate(-2deg);
  }
.page-hero__stamp :global(svg) {
    flex: 0 0 auto;
    color: var(--pink-deep);
  }
:global(.page-hero__doodle) {
    opacity: 0.55;
  }
:global(.page-hero__doodle--butterfly) {
    width: clamp(48px, 8vw, 94px);
    top: 12%;
    left: 4%;
  }
:global(.page-hero__doodle--sparkle) {
    width: clamp(34px, 5vw, 58px);
    bottom: 12%;
    right: 6%;
    color: var(--gold);
  }

  @media (max-width: 900px) {
.page-hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
.page-hero__copy {
      justify-items: center;
      max-width: 640px;
    }
.page-hero h1, .page-hero .lead {
      max-width: 22ch;
    }
.page-hero .lead {
      max-width: 50ch;
    }
.page-hero__visual {
      max-width: 360px;
    }
  }

  @media (max-width: 560px) {
.page-hero__frame {
      aspect-ratio: 1 / 1.12;
    }
.page-hero__stamp {
      left: 0;
      bottom: 0.75rem;
    }
:global(.page-hero__doodle) {
      display: none;
    }
  }
</style>
