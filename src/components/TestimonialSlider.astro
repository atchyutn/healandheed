---
import Icon from './Icon.astro';
import { testimonials } from '../data/content';
---

<div class="testimonial-slider" data-testimonial-slider>
  <div class="testimonial-slider__track" data-testimonial-track>
    {
      testimonials.map((testimonial, index) => (
        <figure class="quote-card" aria-label={`Testimonial ${index + 1} of ${testimonials.length}`}>
          <div class="quote-card__top">
            <span class="quote-card__mark" aria-hidden="true"><Icon name="quote" size={18} /></span>
            <div class="quote-card__stars" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" size={13} />
              ))}
            </div>
          </div>
          <blockquote>{testimonial.quote}</blockquote>
          <figcaption>
            <span class="quote-card__avatar" aria-hidden="true">
              {testimonial.name.charAt(0)}
            </span>
            <span class="quote-card__person">
              <strong>{testimonial.name}</strong>
              <small>{testimonial.context}</small>
            </span>
            {testimonial.source && (
              <span class="quote-card__source">{testimonial.source}</span>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <div class="testimonial-slider__controls">
    <div class="testimonial-slider__buttons">
      <button type="button" data-slider-prev aria-label="Previous testimonial">
        <Icon name="arrow" size={17} />
      </button>
      <button type="button" data-slider-next aria-label="Next testimonial">
        <Icon name="arrow" size={17} />
      </button>
    </div>
  </div>
</div>

<script>
  const slider = document.querySelector<HTMLElement>('[data-testimonial-slider]');
  if (slider) {
    const track = slider.querySelector<HTMLElement>('[data-testimonial-track]');
    const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');

    const step = () => {
      const card = track?.querySelector<HTMLElement>('.quote-card');
      return card ? card.offsetWidth + 20 : 360;
    };

    const updateButtons = () => {
      if (!track) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (prev) prev.disabled = track.scrollLeft <= 8;
      if (next) next.disabled = track.scrollLeft >= maxScroll - 8;
    };

    prev?.addEventListener('click', () => {
      track?.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    next?.addEventListener('click', () => {
      track?.scrollBy({ left: step(), behavior: 'smooth' });
    });

    track?.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons, { passive: true });
    updateButtons();
  }
</script>

<style>
.testimonial-slider {
    position: relative;
  }
.testimonial-slider__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2.5rem) / 3);
    gap: 1.25rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
.testimonial-slider__track::-webkit-scrollbar {
    display: none;
  }
.quote-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    min-height: 360px;
    padding: clamp(1.6rem, 2.4vw, 2.2rem);
    overflow: hidden;
    border: 1px solid rgba(45, 22, 116, 0.09);
    border-radius: 28px;
    background:
      radial-gradient(130% 90% at 0% 0%, rgba(227, 108, 138, 0.08), transparent 58%),
      var(--white);
    box-shadow: 0 18px 44px -30px rgba(45, 22, 116, 0.32);
    scroll-snap-align: start;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
.quote-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--pink), var(--gold));
  }
.quote-card:nth-child(3n + 2)::before {
    background: linear-gradient(90deg, var(--blue-soft), var(--periwinkle-deep));
  }
.quote-card:nth-child(3n)::before {
    background: linear-gradient(90deg, var(--sage-deep), var(--gold));
  }
.quote-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
.quote-card__mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--pink-wash);
    color: var(--pink-deep);
  }
.quote-card__mark :global(svg) {
    fill: currentColor;
  }
.quote-card__stars {
    display: flex;
    gap: 0.18rem;
    color: var(--gold);
  }
.quote-card__stars :global(svg) {
    fill: currentColor;
  }
.quote-card blockquote {
    display: flex;
    flex: 1;
    align-items: center;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: clamp(1.08rem, 1.3vw, 1.24rem);
    line-height: 1.62;
  }
.quote-card figcaption {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }
.quote-card__avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pink), var(--pink-deep));
    color: var(--white);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    box-shadow: 0 10px 20px -14px rgba(201, 79, 112, 0.9);
  }
.quote-card:nth-child(3n + 2) .quote-card__avatar {
    background: linear-gradient(135deg, var(--blue-soft), var(--purple));
    box-shadow: 0 10px 20px -14px rgba(45, 22, 116, 0.9);
  }
.quote-card:nth-child(3n) .quote-card__avatar {
    background: linear-gradient(135deg, var(--gold), var(--pink-deep));
    box-shadow: 0 10px 20px -14px rgba(231, 182, 92, 0.9);
  }
.quote-card__person {
    flex: 1;
    min-width: 0;
  }
.quote-card figcaption strong {
    display: block;
    color: var(--purple);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
  }
.quote-card figcaption small {
    display: block;
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.5;
  }
.quote-card__source {
    align-self: center;
    padding: 0.24rem 0.56rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
@media (hover: hover) {
.quote-card:hover {
      transform: translateY(-4px);
      border-color: var(--line-strong);
      box-shadow: 0 28px 60px -32px rgba(45, 22, 116, 0.36);
    }
  }
.testimonial-slider__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1.5rem;
  }
.testimonial-slider__buttons {
    display: flex;
    gap: 0.5rem;
  }
.testimonial-slider__buttons button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--purple);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
.testimonial-slider__buttons button:hover:not(:disabled) {
    background: var(--purple);
    border-color: var(--purple);
    color: var(--white);
  }
.testimonial-slider__buttons button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
.testimonial-slider__buttons button:first-child :global(svg) {
    transform: rotate(180deg);
  }

  @media (max-width: 1040px) {
.testimonial-slider__track {
      grid-auto-columns: calc((100% - 1.25rem) / 2);
    }
  }

  @media (max-width: 680px) {
.testimonial-slider__track {
      grid-auto-columns: minmax(270px, 86%);
    }
.quote-card {
      min-height: 320px;
    }
.quote-card__source {
      display: none;
    }
  }
</style>
