---
import Icon from './Icon.astro';
import { testimonials } from '../data/content';
---

<div class="testimonial-slider" data-testimonial-slider>
  <div class="testimonial-slider__track" data-testimonial-track>
    {
      testimonials.map((testimonial, index) => (
        <figure class="quote-card" aria-label={`Testimonial ${index + 1} of ${testimonials.length}`}>
          <div class="quote-card__top">
            <span class="quote-card__mark" aria-hidden="true">“</span>
            <div class="quote-card__stars" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" size={13} />
              ))}
            </div>
          </div>
          <blockquote>{testimonial.quote}</blockquote>
          <figcaption>
            <span class="quote-card__avatar" aria-hidden="true">
              {testimonial.name.charAt(0)}
            </span>
            <span>
              <strong>{testimonial.name}</strong>
              <small>{testimonial.context} · Heal &amp; Heed</small>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
  <div class="testimonial-slider__controls">
    <p class="testimonial-slider__hint">A few words from families we work with</p>
    <div class="testimonial-slider__buttons">
      <button type="button" data-slider-prev aria-label="Previous testimonial">
        <Icon name="arrow" size={17} />
      </button>
      <button type="button" data-slider-next aria-label="Next testimonial">
        <Icon name="arrow" size={17} />
      </button>
    </div>
  </div>
</div>

<script>
  const slider = document.querySelector<HTMLElement>('[data-testimonial-slider]');
  if (slider) {
    const track = slider.querySelector<HTMLElement>('[data-testimonial-track]');
    const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');

    const step = () => {
      const card = track?.querySelector<HTMLElement>('.quote-card');
      return card ? card.offsetWidth + 20 : 360;
    };

    const updateButtons = () => {
      if (!track) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (prev) prev.disabled = track.scrollLeft <= 8;
      if (next) next.disabled = track.scrollLeft >= maxScroll - 8;
    };

    prev?.addEventListener('click', () => {
      track?.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    next?.addEventListener('click', () => {
      track?.scrollBy({ left: step(), behavior: 'smooth' });
    });

    track?.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons, { passive: true });
    updateButtons();
  }
</script>

<style>
.testimonial-slider {
    position: relative;
  }
.testimonial-slider__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(320px, 43%);
    gap: 1.25rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
.testimonial-slider__track::-webkit-scrollbar {
    display: none;
  }
.quote-card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-height: 330px;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    scroll-snap-align: start;
  }
.quote-card:nth-child(2n) {
    background: var(--blush);
  }
.quote-card:nth-child(3n) {
    background: var(--periwinkle);
    border-color: transparent;
  }
.quote-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
.quote-card__mark {
    font-family: var(--font-serif);
    font-size: 3.4rem;
    line-height: 0.6;
    color: var(--pink);
  }
.quote-card__stars {
    display: flex;
    gap: 0.18rem;
    color: var(--gold);
  }
.quote-card__stars :global(svg) {
    fill: currentColor;
  }
.quote-card blockquote {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    font-style: italic;
    line-height: 1.55;
    flex: 1;
  }
.quote-card figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
.quote-card__avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
  }
.quote-card figcaption strong {
    display: block;
    color: var(--purple);
    font-size: 0.8rem;
    font-weight: 600;
  }
.quote-card figcaption small {
    display: block;
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.5;
  }
.testimonial-slider__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.4rem;
  }
.testimonial-slider__hint {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
.testimonial-slider__buttons {
    display: flex;
    gap: 0.5rem;
  }
.testimonial-slider__buttons button {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--purple);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
.testimonial-slider__buttons button:hover:not(:disabled) {
    background: var(--purple);
    border-color: var(--purple);
    color: var(--white);
  }
.testimonial-slider__buttons button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
.testimonial-slider__buttons button:first-child :global(svg) {
    transform: rotate(180deg);
  }

  @media (max-width: 760px) {
.testimonial-slider__track {
      grid-auto-columns: minmax(280px, 88%);
    }
  }
</style>
