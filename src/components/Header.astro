---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="site-header__inner container">
    <a class="brand" href="/" aria-label="Heal & Heed home">
      <span class="brand__plate">
        <Logo width={250} variant="white" eager />
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={site.phoneHref} aria-label={`Call ${site.name} on ${site.phone}`}>
        <Icon name="phone" size={17} />
        <span>{site.phone}</span>
      </a>
      <a class="btn btn--small header-cta" href="/online-sessions/">
        Book a session
        <Icon name="arrow" size={14} />
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__label">Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="menu-scrim" data-menu-scrim hidden></div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <nav aria-label="Mobile navigation">
      <ul>
        {
          nav.map((item, index) => (
            <li style={`--i:${index}`}>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span>{item.label}</span>
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu__footer">
      <a class="btn" href="/online-sessions/">
        Book an online session
        <Icon name="arrow" size={15} />
      </a>
      <a class="mobile-menu__call" href={site.phoneHref}>
        <Icon name="phone" size={18} />
        {site.phone}
      </a>
      <p>{site.hours}</p>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const scrim = header.querySelector<HTMLElement>('[data-menu-scrim]');
    const panel = header.querySelector<HTMLElement>('[data-mobile-menu]');
    const closeLabel = 'Close';
    const openLabel = 'Menu';

    const setMenu = (open: boolean) => {
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('no-scroll', open);
      if (toggle) {
        toggle.setAttribute('aria-expanded', String(open));
        const label = toggle.querySelector<HTMLElement>('.menu-toggle__label');
        if (label) label.textContent = open ? closeLabel : openLabel;
      }
      if (scrim) scrim.hidden = !open;
      if (open) {
        panel?.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      }
    };

    toggle?.addEventListener('click', () => {
      setMenu(!header.classList.contains('is-open'));
    });

    scrim?.addEventListener('click', () => setMenu(false));

    panel?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        setMenu(false);
        toggle?.focus();
      }
    });

    window.matchMedia('(min-width: 981px)').addEventListener('change', (event) => {
      if (event.matches && header.classList.contains('is-open')) setMenu(false);
    });

    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 14);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
.site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 244, 233, 0.88);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
.site-header.is-scrolled, .site-header.is-open {
    background: rgba(250, 244, 233, 0.97);
    border-bottom-color: var(--line);
    box-shadow: 0 10px 30px -22px rgba(45, 22, 116, 0.35);
  }
.site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }
.brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding-block: 0.4rem;
    text-decoration: none;
  }
.brand__plate {
    display: inline-flex;
    padding: 6px;
    border-radius: 17px;
    background:
      radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.22), transparent 42%),
      linear-gradient(135deg, #43239e 0%, var(--purple) 58%, #211056 100%);
    box-shadow:
      0 14px 26px -16px rgba(45, 22, 116, 0.75),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
.brand:hover .brand__plate {
    transform: translateY(-1px);
    box-shadow:
      0 18px 32px -16px rgba(45, 22, 116, 0.8),
      inset 0 0 0 1px rgba(255, 255, 255, 0.26);
  }
.brand :global(img) {
    display: block;
    width: clamp(166px, 18vw, 250px);
    height: auto;
    border-radius: 12px;
  }
.desktop-nav {
    margin-left: auto;
  }
.desktop-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 1.8vw, 1.75rem);
  }
.desktop-nav a {
    position: relative;
    display: inline-flex;
    padding-block: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
.desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--pink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
.desktop-nav a:hover, .desktop-nav a[aria-current='page'] {
    color: var(--purple);
  }
.desktop-nav a:hover::after, .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
.header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 0.25rem;
  }
.header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding-inline: 0.25rem;
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
.header-phone:hover {
    color: var(--pink-deep);
  }
.header-phone :global(svg) {
    color: var(--pink-deep);
  }
.menu-toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--purple);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
.menu-toggle__icon {
    position: relative;
    display: grid;
    gap: 5px;
    width: 17px;
  }
.menu-toggle__icon span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }
.is-open .menu-toggle__icon span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
.is-open .menu-toggle__icon span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
.menu-scrim {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 1;
    background: rgba(43, 26, 51, 0.25);
    backdrop-filter: blur(2px);
  }
.mobile-menu {
    position: absolute;
    z-index: 2;
    top: 100%;
    left: 0;
    right: 0;
    display: none;
    padding: 1rem var(--gutter) 2rem;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 30px 50px -30px rgba(45, 22, 116, 0.4);
  }
.mobile-menu nav ul {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.75rem 1.5rem;
  }
.mobile-menu nav li {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    transition-delay: calc(var(--i) * 45ms + 60ms);
  }
.is-open .mobile-menu nav li {
    opacity: 1;
    transform: none;
  }
.mobile-menu nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--purple);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    text-decoration: none;
  }
.mobile-menu nav a[aria-current='page'] {
    color: var(--pink-deep);
  }
.mobile-menu nav a :global(svg) {
    color: var(--pink);
  }
.mobile-menu__footer {
    display: grid;
    gap: 0.9rem;
  }
.mobile-menu__footer .btn {
    justify-self: start;
  }
.mobile-menu__call {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--purple);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
.mobile-menu__footer p {
    color: var(--muted);
    font-size: 0.72rem;
  }

  @media (max-width: 1100px) {
.header-phone span {
      display: none;
    }
  }

  @media (max-width: 980px) {
.desktop-nav, .header-cta {
      display: none;
    }
.header-actions {
      margin-left: auto;
    }
.menu-toggle {
      display: inline-flex;
    }
.is-open .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 520px) {
.header-phone {
      display: none;
    }
.brand :global(img) {
      width: 150px;
    }
.brand__plate {
      padding: 5px;
      border-radius: 15px;
    }
.brand :global(img) {
      border-radius: 10px;
    }
  }

  @media (max-width: 360px) {
.site-header__inner {
      gap: 0.65rem;
    }
.brand :global(img) {
      width: 134px;
    }
.menu-toggle {
      padding: 0.55rem 0.65rem;
      letter-spacing: 0.02em;
    }
  }
</style>
