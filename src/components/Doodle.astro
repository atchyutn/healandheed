---
interface Props {
  type:
    | 'butterfly'
    | 'sparkle'
    | 'star'
    | 'flower'
    | 'sun'
    | 'giraffe'
    | 'leaf'
    | 'squiggle'
    | 'heart'
    | 'rainbow';
  class?: string;
  color?: string;
}
const { type, class: className = '', color } = Astro.props;
---

<span
  class:list={['doodle', className]}
  style={color ? `color:${color}` : undefined}
  aria-hidden="true"
>
  {type === 'butterfly' && (
    <svg viewBox="0 0 120 100" fill="none">
      <path
        d="M58 35C50 17 23 8 13 23 4 37 23 53 45 55 23 57 4 73 13 87c10 15 37 6 45-12"
        fill="currentColor"
        opacity=".9"
      />
      <path
        d="M62 35C70 17 97 8 107 23c9 14-10 30-32 32 22 2 41 18 32 32-10 15-37 6-45-12"
        fill="currentColor"
        opacity=".55"
      />
      <path d="M60 30v43" stroke="#2d1674" stroke-width="2.4" stroke-linecap="round" />
      <path d="M57 28c-2.5-8-7-11-12-10M63 28c2.5-8 7-11 12-10" stroke="#2d1674" stroke-width="1.6" stroke-linecap="round" />
      <circle cx="60" cy="40" r="3.2" fill="#2d1674" />
    </svg>
  )}

  {type === 'sparkle' && (
    <svg viewBox="0 0 100 100" fill="none">
      <path d="M50 4c2 26 20 44 46 46-26 2-44 20-46 46-2-26-20-44-46-46C30 48 48 30 50 4Z" stroke="currentColor" stroke-width="2" />
      <path d="M82 66c.8 8 5.2 12.2 14 14-8.8 1.8-13.2 6-14 14-.8-8-5.2-12.2-14-14 8.8-1.8 13.2-6 14-14Z" fill="currentColor" opacity=".45" />
    </svg>
  )}

  {type === 'star' && (
    <svg viewBox="0 0 100 100" fill="none">
      <path d="m50 5 10.5 28.5L90 44.5 60.5 55 50 84 39.5 55 10 44.5l29.5-11L50 5Z" fill="currentColor" opacity=".55" />
      <path d="m50 5 10.5 28.5L90 44.5 60.5 55 50 84 39.5 55 10 44.5l29.5-11L50 5Z" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )}

  {type === 'flower' && (
    <svg viewBox="0 0 100 130" fill="none">
      <path d="M50 56v67" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <path d="M50 96c-10-2-19 2-23 10 10 2 19-2 23-10Z" fill="currentColor" opacity=".28" />
      <path d="M50 108c10-2 19 2 23 10-10 2-19-2-23-10Z" fill="currentColor" opacity=".28" />
      <g stroke="currentColor" stroke-width="1.8">
        <ellipse cx="50" cy="22" rx="10" ry="16" />
        <ellipse cx="50" cy="22" rx="10" ry="16" transform="rotate(60 50 42)" />
        <ellipse cx="50" cy="22" rx="10" ry="16" transform="rotate(120 50 42)" />
        <ellipse cx="50" cy="22" rx="10" ry="16" transform="rotate(180 50 42)" />
        <ellipse cx="50" cy="22" rx="10" ry="16" transform="rotate(240 50 42)" />
        <ellipse cx="50" cy="22" rx="10" ry="16" transform="rotate(300 50 42)" />
      </g>
      <circle cx="50" cy="42" r="9" fill="currentColor" opacity=".45" />
    </svg>
  )}

  {type === 'sun' && (
    <svg viewBox="0 0 120 120" fill="none">
      <circle cx="60" cy="60" r="23" fill="currentColor" opacity=".35" />
      <circle cx="60" cy="60" r="23" stroke="currentColor" stroke-width="2" />
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M60 9v13M60 98v13M9 60h13M98 60h13M24 24l9 9M87 87l9 9M96 24l-9 9M33 87l-9 9" />
      </g>
      <circle cx="53" cy="57" r="2.1" fill="currentColor" />
      <circle cx="67" cy="57" r="2.1" fill="currentColor" />
      <path d="M54 65c3.5 3 8.5 3 12 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )}

  {type === 'giraffe' && (
    <svg viewBox="0 0 160 190" fill="none">
      <g stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 174v-39M78 174v-39M95 174v-36M48 174v-36" />
        <path d="M42 106c-10-1-17 5-16 13 1 6 8 8 13 4" />
        <ellipse cx="72" cy="112" rx="32" ry="21" fill="currentColor" fill-opacity=".08" />
        <path d="M92 105c5-24 6-50 12-65M81 105c4-24 5-49 12-67" />
        <path d="M104 40c-2-9 4-15 11-15s12 8 8 16c3 2 4 6 2 9-3 5-10 6-16 4-5-2-7-8-5-14Z" fill="currentColor" fill-opacity=".08" />
        <path d="M109 26l2-11M117 26l6-9" />
        <circle cx="108" cy="12" r="3.2" fill="currentColor" fill-opacity=".3" />
        <circle cx="125" cy="14" r="3.2" fill="currentColor" fill-opacity=".3" />
        <circle cx="118" cy="38" r="1.7" fill="currentColor" />
        <path d="M43 118c2 12 2 23 0 34M101 118c-1 8-1 16 0 24" />
        <circle cx="62" cy="104" r="4" fill="currentColor" fill-opacity=".22" />
        <circle cx="76" cy="112" r="5" fill="currentColor" fill-opacity=".22" />
        <circle cx="90" cy="103" r="3.5" fill="currentColor" fill-opacity=".22" />
        <circle cx="68" cy="122" r="3.2" fill="currentColor" fill-opacity=".22" />
        <circle cx="84" cy="120" r="4.2" fill="currentColor" fill-opacity=".22" />
      </g>
    </svg>
  )}

  {type === 'leaf' && (
    <svg viewBox="0 0 120 140" fill="none">
      <path d="M18 128C42 100 68 64 102 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <path d="M50 88C27 86 13 70 14 48c23-1 38 14 36 40Z" fill="currentColor" opacity=".25" stroke="currentColor" stroke-width="1.5" />
      <path d="M68 66c-3-21 8-38 29-44 5 21-5 38-29 44Z" fill="currentColor" opacity=".18" stroke="currentColor" stroke-width="1.5" />
      <path d="M39 111c-15-4-29 3-33 17 16 4 29-3 33-17Z" fill="currentColor" opacity=".22" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )}

  {type === 'squiggle' && (
    <svg viewBox="0 0 220 40" fill="none">
      <path d="M4 28c18-22 35-22 53 0s35 22 53 0 35-22 53 0 35 22 53 0" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    </svg>
  )}

  {type === 'heart' && (
    <svg viewBox="0 0 100 100" fill="none">
      <path d="M50 88C22 69 8 53 8 34 8 18 19 8 33 8c9 0 15 5 17 10 2-5 8-10 17-10 14 0 25 10 25 26 0 19-14 35-42 54Z" fill="currentColor" opacity=".28" stroke="currentColor" stroke-width="2" />
    </svg>
  )}

  {type === 'rainbow' && (
    <svg viewBox="0 0 160 110" fill="none">
      <path d="M14 96a66 66 0 0 1 132 0" stroke="currentColor" stroke-width="9" stroke-linecap="round" />
      <path d="M31 96a49 49 0 0 1 98 0" stroke="currentColor" stroke-width="7" stroke-linecap="round" opacity=".6" />
      <path d="M48 96a32 32 0 0 1 64 0" stroke="currentColor" stroke-width="6" stroke-linecap="round" opacity=".35" />
    </svg>
  )}
</span>
