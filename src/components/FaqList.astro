---
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<div class:list={['faq-list accordion', className]}>
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <div class="accordion__body">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
.faq-list {
    max-width: 860px;
    margin-inline: auto;
  }
.faq-list summary {
    padding: 1.25rem 1.35rem;
    font-size: 1rem;
  }
.faq-list .accordion__body {
    padding: 0 1.35rem 1.35rem;
    font-size: 0.94rem;
    max-width: 72ch;
  }
</style>
