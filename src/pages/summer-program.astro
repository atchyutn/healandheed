---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtPanel from '../components/ArtPanel.astro';
import CtaBand from '../components/CtaBand.astro';
import Doodle from '../components/Doodle.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {
  codingWeeks,
  summer,
  summerCoding,
  summerEveryday,
  summerFaqs,
  summerGains,
  summerParentUpdates,
  summerPromises,
  summerSchedule,
  summerWeeks,
} from '../data/summer';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema, webPageSchema } from '../lib/schema';

const coreSchedule = summerSchedule.filter(
  (block) => block.badge !== 'Closes every day'
);
const closingBlock = summerSchedule.find(
  (block) => block.badge === 'Closes every day'
);

const description =
  'Five weeks of therapeutic play, life skills and social learning for children aged 2–12 in L.B. Nagar, Hyderabad. Optional coding add-on.';

const summerOffers = [
  {
    '@type': 'Offer',
    name: 'Therapy Programme',
    price: '5000',
    priceCurrency: 'INR',
    description: 'Five weeks of structured therapeutic activities, Monday to Friday, 10:00 AM to 3:00 PM.',
  },
  {
    '@type': 'Offer',
    name: 'Programming Add-On',
    price: '3000',
    priceCurrency: 'INR',
    description: 'Optional coding session, 3:00 PM to 4:00 PM, or standalone enrolment for children aged 4–12.',
  },
  {
    '@type': 'Offer',
    name: 'Therapy and Programming',
    price: '8000',
    priceCurrency: 'INR',
    description: 'The full programme, including the therapy day and the coding add-on.',
  },
];

const summerServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Heal & Heed Summer Programme 2026',
  description,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'City', name: 'Hyderabad' },
  audience: {
    '@type': 'PeopleAudience',
    suggestedMinAge: 2,
    suggestedMaxAge: 12,
  },
  offers: summerOffers,
};

const summerCourseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Heal & Heed Summer Programme 2026',
  description,
  provider: { '@id': `${site.url}/#organization` },
  educationalLevel: 'Ages 2–12',
  inLanguage: 'en-IN',
  coursePrerequisites: 'No prior experience required.',
  offers: summerOffers,
  hasCourseInstance: {
    '@type': 'CourseInstance',
    name: 'Summer Programme 2026 — five-week day programme',
    courseMode: 'Onsite',
    courseWorkload: 'PT125H',
    location: {
      '@type': 'Place',
      name: site.name,
      address: site.addressString,
    },
  },
};

const schemas = [
  webPageSchema({
    name: 'Summer Programme 2026',
    description,
    path: '/summer-program/',
  }),
  summerServiceSchema,
  summerCourseSchema,
  faqSchema(summerFaqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Summer Programme 2026', path: '/summer-program/' },
  ]),
];
---

<BaseLayout
  title="Summer Programme 2026 in Hyderabad"
  description={description}
  jsonLd={schemas}
>
  <PageHero
    eyebrow="Summer Programme 2026"
    breadcrumb="Summer programme 2026"
    title="A summer of play,"
    accent="practice and progress."
    lead={summer.intro}
    imageTone="gold"
    badge="Five weeks · Ages 2–12 · L.B. Nagar"
  >
    <ArtPanel
      slot="visual"
      layout="orbit"
      tone="gold"
      centerIcon="sun"
      items={[
        { icon: 'blocks' },
        { icon: 'users' },
        { icon: 'calendar' },
        { icon: 'play' },
      ]}
      eyebrow="Five weeks · Ages 2–12"
      title="Structure, play and room to grow."
    />
    <div class="summer-facts" aria-label="Programme at a glance">
      <div>
        <span>Ages</span>
        <strong>2–12 years</strong>
      </div>
      <div>
        <span>Dates</span>
        <strong>Five weeks · Mon–Fri</strong>
      </div>
      <div>
        <span>Core day</span>
        <strong>10:00 AM – 3:00 PM</strong>
      </div>
      <div>
        <span>Optional add-on</span>
        <strong>Coding · 3:00 – 4:00 PM</strong>
      </div>
    </div>

    <div class="button-row summer-actions">
      <a
        class="btn"
        href={site.whatsappSummer}
        target="_blank"
        rel="noopener noreferrer"
      >
        Ask about enrolling
        <Icon name="arrow" size={15} />
      </a>
      <a class="btn btn--secondary" href="#schedule">See a typical day</a>
    </div>
  </PageHero>

  <!-- Pull quote -->
  <section class="section section--periwinkle section--tight summer-intro">
    <div class="container summer-intro__inner">
      <Doodle type="sun" class="summer-intro__sun" />
      <Doodle type="squiggle" class="summer-intro__squiggle" />
      <blockquote>
        “Most children do better with <em>structure, not less of it.</em>”
      </blockquote>
      <p>
        This programme gives children a safe place to practise the skills that
        make school and home life easier, in a group small enough to be noticed.
      </p>
      <cite>The Heal &amp; Heed team</cite>

      <div class="summer-intro__stats">
        <div><strong>5</strong><span>themed weeks</span></div>
        <div><strong>10</strong><span>planned daily blocks</span></div>
        <div><strong>2–12</strong><span>years old</span></div>
        <div><strong>1</strong><span>summer well spent</span></div>
      </div>
    </div>
  </section>

  <!-- Daily promises -->
  <section class="section section--white promises">
    <div class="container">
      <SectionHeading
        eyebrow="Every single day"
        title="What your child"
        accent="does here."
        lead="Five themed weeks, ten planned blocks each day, none too long — so your child never runs out of steam or patience."
      />

      <div class="promise-grid">
        {summerPromises.map((promise, index) => (
          <article class="promise-card reveal" style={`--reveal-delay:${index * 55}ms`}>
            <div class="promise-card__top">
              <span class="promise-card__number">{promise.number}</span>
              <span class="promise-card__line" aria-hidden="true"></span>
            </div>
            <h3>{promise.title}</h3>
            <p>{promise.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Schedule -->
  <section class="section section--blush schedule" id="schedule">
    <div class="container schedule__grid">
      <div class="schedule__intro reveal">
        <span class="eyebrow">A day at the programme</span>
        <h2>Predictable, purposeful, <em>paced.</em></h2>
        <p class="lead">
          The day has a rhythm. Your child knows what comes next, which makes it
          easier to settle, join in and try something new.
        </p>
        <p>
          Times are for the core therapy programme. Children staying for the
          optional coding session continue from 3:00 PM.
        </p>
        <div class="schedule__legend">
          <span><i class="dot dot--pink"></i> Core learning</span>
          <span><i class="dot dot--sage"></i> Weekly focus</span>
          <span><i class="dot dot--gold"></i> Optional add-on</span>
        </div>
        <a class="text-link" href="#curriculum">
          See the five-week curriculum
          <Icon name="arrow" size={14} />
        </a>
      </div>

      <ol class="summer-schedule">
        {coreSchedule.map((block, index) => (
          <li
            class:list={[
              'schedule-row',
              block.badge === 'Optional add-on' && 'schedule-row--addon',
            ]}
            style={`--reveal-delay:${Math.min(index * 35, 280)}ms`}
          >
            <div class="schedule-row__time">
              <span>{block.time}</span>
              {block.badge && <small>{block.badge}</small>}
            </div>
            <div class="schedule-row__body">
              <h3>{block.title}</h3>
              <p>{block.text}</p>
              <span class="schedule-row__outcome">
                <Icon name="check" size={12} />
                {block.outcome}
              </span>
            </div>
          </li>
        ))}
      </ol>
    </div>

    {closingBlock && (
      <div class="container">
        <p class="schedule__closing reveal">
          <Icon name="sun" size={16} />
          <span>{closingBlock.text}</span>
          <strong>Pick-up at 3:00 PM · 4:00 PM after coding.</strong>
        </p>
      </div>
    )}
  </section>

  <!-- Parent updates -->
  <section class="section section--periwinkle parent-updates">
    <Doodle type="giraffe" class="parent-updates__giraffe" />
    <div class="container">
      <SectionHeading
        eyebrow="You are kept close"
        title="You will know"
        accent="how it is going."
        lead="You are not handing your child over and waiting for a report. Updates happen in small, useful moments."
      />

      <div class="parent-grid">
        {summerParentUpdates.map((update, index) => (
          <article class="parent-card reveal" style={`--reveal-delay:${index * 65}ms`}>
            <span class="parent-card__number">0{index + 1}</span>
            <h3>{update.title}</h3>
            <p>{update.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Curriculum -->
  <section class="section section--white curriculum" id="curriculum">
    <div class="container">
      <SectionHeading
        eyebrow="Five-week curriculum"
        title="A different world"
        accent="each week."
        lead="Every theme is chosen to connect with what children already know and love, while building skills that carry into school and home."
      />

      <div class="weeks-grid">
        {summerWeeks.map((week, index) => (
          <article class:list={['week-card', index === 0 && 'week-card--feature']} style={`--reveal-delay:${index * 55}ms`}>
            <div class="week-card__top">
              <span class="week-card__week">{week.week}</span>
              <span class="week-card__theme">{week.theme}</span>
            </div>
            <h3>{week.title}</h3>
            <ul class="week-card__activities">
              {week.activities.map((activity) => (
                <li>{activity}</li>
              ))}
            </ul>
            <p class="week-card__skills">
              <span>Skills built</span>
              {week.skills}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Everyday extras -->
  <section class="section section--pink-solid everyday">
    <div class="container">
      <SectionHeading
        eyebrow="Every day, all five weeks"
        title="The foundations,"
        accent="built in."
        lead="These run alongside the weekly themes, not as extras but as the ground the rest of the day stands on."
      />

      <div class="everyday-grid">
        {summerEveryday.map((item, index) => (
          <article class="everyday-card reveal" style={`--reveal-delay:${index * 60}ms`}>
            <span class="everyday-card__numeral">{item.numeral}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Gains -->
  <section class="section section--white gains">
    <div class="container">
      <SectionHeading
        eyebrow="By the end of the programme"
        title="What parents"
        accent="notice."
        lead="Five weeks is long enough to see real change. These are the shifts families tell us about most often."
      />

      <div class="gains-grid">
        {summerGains.map((gain, index) => (
          <article class="gain reveal" style={`--reveal-delay:${index * 55}ms`}>
            <span class="gain__number">{gain.number}</span>
            <h3>{gain.title}</h3>
            <p>{gain.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Coding -->
  <section class="section coding" id="coding">
    <div class="coding__blob coding__blob--one" aria-hidden="true"></div>
    <div class="coding__blob coding__blob--two" aria-hidden="true"></div>
    <Doodle type="sparkle" class="coding__doodle" />
    <div class="container">
      <div class="coding__head">
        <div>
          <span class="eyebrow coding__eyebrow">Add-on or standalone · Ages 4–12</span>
          <h2>Programming basics<br /><em>for young thinkers.</em></h2>
        </div>
        <p>{summerCoding.intro}</p>
      </div>

      <div class="coding-grid">
        {codingWeeks.map((week, index) => (
          <article class="coding-card reveal" style={`--reveal-delay:${index * 60}ms`}>
            <span class="coding-card__week">{week.week}</span>
            <h3>{week.title}</h3>
            <ul>
              {week.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <div class="coding-card__tools">
              {week.tools.map((tool) => (
                <span>{tool}</span>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="coding__note reveal">
        <Icon name="sparkle" size={18} />
        <p>{summerCoding.note}</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section section--mauve pricing" id="fees">
    <div class="container">
      <SectionHeading
        eyebrow="Programme fees"
        title="Simple, transparent"
        accent="pricing."
        lead="One programme, one fee. Fees are per child, per month. Call or message us to confirm availability."
      />

      <div class="pricing-grid">
        <article class="price-card reveal">
          <div class="price-card__head">
            <span class="price-card__label">Therapy programme</span>
            <div class="price-card__amount">
              <span>₹</span>{summer.fees.therapy}
              <small>/ child / month</small>
            </div>
            <p>Five weeks of structured therapeutic activities, Monday to Friday, 10:00 AM to 3:00 PM.</p>
          </div>
          <ul class="price-card__list">
            <li>Daily schedule across structured blocks</li>
            <li>Life skills and independence practice</li>
            <li>Social play and communication work</li>
            <li>Creative corner and free play</li>
            <li>Five-week themed curriculum</li>
          </ul>
          <a
            class="btn btn--secondary price-card__cta"
            href={site.whatsappSummer}
            target="_blank"
            rel="noopener noreferrer"
          >
            Enquire about therapy
            <Icon name="arrow" size={15} />
          </a>
        </article>

        <article class="price-card reveal" style="--reveal-delay:70ms">
          <div class="price-card__head">
            <span class="price-card__label">Programming add-on</span>
            <div class="price-card__amount">
              <span>₹</span>{summer.fees.coding}
              <small>/ child / month</small>
            </div>
            <p>Enrol only for programming if therapy is not required. Open to all children, including neurotypical siblings.</p>
          </div>
          <ul class="price-card__list">
            <li>Four-week coding curriculum</li>
            <li>ScratchJr, Code.org and Lightbot Jr</li>
            <li>Suits ages 4–12, no prior experience</li>
            <li>Week 4 mini project</li>
            <li>Certificate at the end</li>
          </ul>
          <a
            class="btn btn--secondary price-card__cta"
            href={site.whatsappSummer}
            target="_blank"
            rel="noopener noreferrer"
          >
            Enquire about coding
            <Icon name="arrow" size={15} />
          </a>
        </article>

        <article class="price-card price-card--featured reveal" style="--reveal-delay:140ms">
          <span class="price-card__badge">Most complete</span>
          <div class="price-card__head">
            <span class="price-card__label">Therapy + coding</span>
            <div class="price-card__amount">
              <span>₹</span>{summer.fees.combined}
              <small>/ child / month</small>
            </div>
            <p>The full summer experience: the therapeutic day plus the optional coding hour.</p>
          </div>
          <ul class="price-card__list">
            <li>Everything in the therapy programme</li>
            <li>Optional daily coding session, 3:00–4:00 PM</li>
            <li>Mini project and certificate</li>
            <li>Ideal for siblings and peers</li>
            <li>One clear schedule for the week</li>
          </ul>
          <a
            class="btn price-card__cta"
            href={site.whatsappSummer}
            target="_blank"
            rel="noopener noreferrer"
          >
            Enquire about the full programme
            <Icon name="arrow" size={15} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--white faq-section">
    <div class="container faq-section__inner">
      <div class="faq-section__intro reveal">
        <span class="eyebrow">Common questions</span>
        <h2>Things parents <em>usually ask.</em></h2>
        <p class="lead">
          If your question is not here, message us with your child’s age and what
          you are looking for. We will take it from there.
        </p>
        <a
          class="btn btn--small"
          href={site.whatsappSummer}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={15} />
          Message us on WhatsApp
        </a>
      </div>
      <div class="faq-section__list reveal" style="--reveal-delay:120ms">
        <FaqList items={summerFaqs} />
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Summer 2026 · L.B. Nagar"
    title="Let’s make this"
    accent="a good summer."
    text="Tell us your child’s age and what you are looking for. We will answer your questions and help you decide whether the programme is the right fit."
    primaryLabel="Message us on WhatsApp"
    primaryHref={site.whatsappSummer}
    secondaryLabel="Call our team"
    secondaryHref={site.phoneHref}
  />
</BaseLayout>

<style>
/* Hero */
  .summer-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    width: 100%;
    margin-top: 1.2rem;
    text-align: left;
  }
.summer-facts > div {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgba(45, 22, 116, 0.1);
    border-radius: 12px;
    background: rgba(255, 253, 249, 0.6);
  }
.summer-facts span {
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
.summer-facts strong {
    color: var(--purple);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
  }
.summer-actions {
    margin-top: 0.6rem;
  }
/* Pull quote */
  .summer-intro {
    position: relative;
    overflow: clip;
  }
.summer-intro__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 900px;
    text-align: center;
  }
.summer-intro blockquote {
    max-width: 860px;
    color: var(--purple);
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
.summer-intro blockquote em {
    color: var(--pink-deep);
    font-style: italic;
  }
.summer-intro p {
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.75;
  }
.summer-intro cite {
    color: var(--pink-deep);
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
.summer-intro__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
    margin-top: 1.4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
.summer-intro__stats div {
    display: grid;
    gap: 0.2rem;
    padding-inline: 0.75rem;
    border-right: 1px solid var(--line);
  }
.summer-intro__stats div:last-child {
    border-right: none;
  }
.summer-intro__stats strong {
    color: var(--purple);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
  }
.summer-intro__stats span {
    color: var(--muted);
    font-size: 0.65rem;
    line-height: 1.4;
  }
:global(.summer-intro__sun) {
    width: clamp(42px, 5vw, 70px);
    top: 8%;
    right: 3%;
    color: var(--gold);
    opacity: 0.7;
  }
:global(.summer-intro__squiggle) {
    width: clamp(80px, 12vw, 150px);
    left: 2%;
    bottom: 14%;
    color: var(--pink);
    opacity: 0.4;
  }
/* Promises */
  .promise-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
.promise-card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.3rem, 2.5vw, 1.9rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
.promise-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
  }
.promise-card__top {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
.promise-card__number {
    color: var(--pink-deep);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-style: italic;
    letter-spacing: 0.06em;
  }
.promise-card__line {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
.promise-card h3 {
    font-size: clamp(1.35rem, 1.9vw, 1.6rem);
  }
.promise-card p {
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1.68;
  }
/* Schedule */
  .schedule__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
.schedule__intro {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 400px;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
.schedule__intro h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.schedule__intro p:not(.lead) {
    color: var(--muted);
    font-size: 0.85rem;
  }
.schedule__legend {
    display: grid;
    gap: 0.45rem;
    margin-block: 0.3rem;
    color: var(--muted);
    font-size: 0.68rem;
  }
.schedule__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
.dot--pink {
    background: var(--pink);
  }
.dot--sage {
    background: var(--sage-deep);
  }
.dot--gold {
    background: var(--gold);
  }
.summer-schedule {
    display: grid;
    gap: 0.65rem;
  }
.schedule-row {
    display: grid;
    grid-template-columns: 128px 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    overflow: hidden;
  }
.schedule-row__time {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    padding: 1rem;
    border-right: 1px solid var(--line);
