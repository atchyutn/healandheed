---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema, webPageSchema } from '../lib/schema';

const description =
  'Contact Heal & Heed in L.B. Nagar, Hyderabad. Call or WhatsApp +91 74168 48323 to book an appointment, ask about therapy or visit our child development centre.';

const contactFaqs = [
  {
    q: 'Do I need a referral to contact you?',
    a: 'No. You can contact us directly. If you already have reports, assessments or school observations, bring them along — they can help us understand your child, but they are not required to start a conversation.',
  },
  {
    q: 'Can I visit without an appointment?',
    a: 'Visits are best by appointment so the right team member can meet you. Call or WhatsApp us first and we will find a time that works.',
  },
  {
    q: 'How soon will I hear back?',
    a: 'We respond during our working hours, Monday to Saturday, 9:00 AM to 6:00 PM. Messages sent outside these hours are answered on the next working day.',
  },
  {
    q: 'Do you offer online sessions?',
    a: 'Yes. Online behaviour therapy sessions can be booked through our online sessions page. For other services, call us and we will talk through the options.',
  },
  {
    q: 'Where exactly are you located?',
    a: 'We are in L.B. Nagar, Hyderabad, beside Vijaya Lakshmi Theatre. Use the directions link on this page for the exact location in Google Maps.',
  },
];

const schemas = [
  webPageSchema({
    name: 'Contact Heal & Heed',
    description,
    path: '/contact/',
    type: 'ContactPage',
  }),
  faqSchema(contactFaqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact/' },
  ]),
];

const contactCards = [
  {
    label: 'Call us',
    value: site.phone,
    text: 'Speak to our team during working hours.',
    href: site.phoneHref,
    action: 'Call now',
    icon: 'phone',
    external: false,
  },
  {
    label: 'WhatsApp',
    value: 'Message our team',
    text: 'Send a question, your child’s age and what you need.',
    href: site.whatsapp,
    action: 'Open WhatsApp',
    icon: 'whatsapp',
    external: true,
  },
  {
    label: 'Visit the centre',
    value: 'L.B. Nagar, Hyderabad',
    text: 'Beside Vijaya Lakshmi Theatre, Sriram Nagar.',
    href: site.mapsUrl,
    action: 'Get directions',
    icon: 'pin',
    external: true,
  },
  {
    label: 'Opening hours',
    value: 'Mon – Sat · 9 AM – 6 PM',
    text: 'Closed on Sundays and public holidays.',
    href: '/online-sessions/',
    action: 'Book a session',
    icon: 'clock',
    external: false,
  },
];
---

<BaseLayout
  title="Contact us — Book an appointment in L.B. Nagar"
  description={description}
  jsonLd={schemas}
>
  <PageHero
    eyebrow="Contact us"
    title="Let’s start with"
    accent="a conversation."
    lead="Tell us what you have noticed, what you are hoping for, or simply ask a question. There is no pressure and no need to have it all figured out before you call."
    compact
  >
    <div class="contact-hero__chips" aria-label="Ways to contact us">
      <span><Icon name="phone" size={14} /> Call</span>
      <span><Icon name="whatsapp" size={14} /> WhatsApp</span>
      <span><Icon name="pin" size={14} /> Visit</span>
      <span><Icon name="clock" size={14} /> Mon–Sat, 9–6</span>
    </div>
  </PageHero>

  <!-- Contact cards -->
  <section class="section section--cream section--tight contact-cards-section">
    <div class="container">
      <div class="contact-cards">
        {contactCards.map((card, index) => (
          <article class="contact-card reveal" style={`--reveal-delay:${index * 55}ms`}>
            <span class="contact-card__icon"><Icon name={card.icon} size={21} /></span>
            <span class="contact-card__label">{card.label}</span>
            <strong>{card.value}</strong>
            <p>{card.text}</p>
            <a
              class="text-link"
              href={card.href}
              target={card.external ? '_blank' : undefined}
              rel={card.external ? 'noopener noreferrer' : undefined}
            >
              {card.action}
              <Icon name="arrow" size={14} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Form and next steps -->
  <section class="section section--white contact-main" id="message">
    <div class="container contact-main__grid">
      <div class="contact-form-wrap reveal">
        <span class="eyebrow">Send a message</span>
        <h2>Tell us a little <em>about your child.</em></h2>
        <p class="contact-form-wrap__lead">
          Fill this in and we will open WhatsApp with your message ready to send.
          You can add or change anything before you press send.
        </p>

        <form class="contact-form" data-contact-form novalidate>
          <div class="contact-form__row">
            <label class="field">
              <span>Your name <em>*</em></span>
              <input
                type="text"
                name="name"
                autocomplete="name"
                required
                placeholder="Your name"
              />
            </label>
            <label class="field">
              <span>Child’s age</span>
              <input
                type="text"
                name="age"
                inputmode="numeric"
                autocomplete="off"
                placeholder="e.g. 6"
              />
            </label>
          </div>

          <label class="field">
            <span>What are you interested in? <em>*</em></span>
            <select name="interest" required>
              <option value="">Please choose</option>
              <option>General enquiry</option>
              <option>Occupational therapy</option>
              <option>Behaviour therapy</option>
              <option>Speech therapy</option>
              <option>Special education</option>
              <option>Online sessions</option>
              <option>Summer programme 2026</option>
              <option>Saturday group therapy</option>
            </select>
          </label>

          <label class="field">
            <span>What would you like us to know?</span>
            <textarea
              name="message"
              rows="5"
              placeholder="A little about what you have noticed, or the question you would like to ask."
            ></textarea>
          </label>

          <div class="contact-form__actions">
            <button class="btn" type="submit">
              <Icon name="whatsapp" size={17} />
              Send on WhatsApp
            </button>
            <span class="contact-form__note">
              This opens WhatsApp with your message ready to send. We do not
              store your details on this website.
            </span>
          </div>
          <p class="contact-form__status" data-form-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="contact-side reveal" style="--reveal-delay:120ms">
        <div class="contact-side__panel">
          <span class="eyebrow">What happens next</span>
          <h2>A clear, <em>kind</em> next step.</h2>
          <ol class="next-steps">
            <li>
              <span>01</span>
              <div>
                <h3>We read your message</h3>
                <p>Our team reads it during working hours and works out who is best placed to help.</p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <h3>We get in touch</h3>
                <p>We call or message you to understand your child and answer your questions.</p>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <h3>We suggest a plan</h3>
                <p>If it feels right, we arrange a consultation or assessment and explain what to expect.</p>
              </div>
            </li>
          </ol>
          <div class="contact-side__call">
            <Icon name="phone" size={18} />
            <span>
              <small>Prefer to talk?</small>
              <a href={site.phoneHref}>{site.phone}</a>
            </span>
          </div>
        </div>

        <div class="hours-card">
          <div class="hours-card__head">
            <span class="hours-card__icon"><Icon name="clock" size={18} /></span>
            <h3>Opening hours</h3>
          </div>
          <ul>
            <li><span>Monday – Saturday</span><strong>9:00 AM – 6:00 PM</strong></li>
            <li><span>Sunday</span><strong>Closed</strong></li>
          </ul>
          <p>Sessions are by appointment. Call ahead so we can find a time that works.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Visit -->
  <section class="section section--sage visit" id="visit">
    <Doodle type="giraffe" class="visit__giraffe" />
    <Doodle type="sun" class="visit__sun" />
    <div class="container visit__grid">
      <div class="visit__copy reveal">
        <span class="eyebrow">Find us</span>
        <h2>Easy to reach, <em>easy to stay.</em></h2>
        <p class="lead">
          We are in L.B. Nagar, beside Vijaya Lakshmi Theatre. If you are coming
          for the first time, call us and we will guide you in.
        </p>
        <address>
          {site.address.line1},<br />
          {site.address.line2},<br />
          {site.address.line3},<br />
          {site.address.line4}, {site.address.line5}
        </address>
        <div class="button-row">
          <a
            class="btn btn--secondary"
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="pin" size={15} />
            Get directions
          </a>
          <a class="btn btn--secondary" href={site.phoneHref}>
            <Icon name="phone" size={15} />
            Call before you come
          </a>
        </div>
      </div>

      <a
        class="visit__map reveal"
        href={site.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open Heal and Heed location in Google Maps"
        style="--reveal-delay:120ms"
      >
        <svg viewBox="0 0 560 380" aria-hidden="true" focusable="false">
          <rect width="560" height="380" rx="28" fill="#f5ead9" />
          <path d="M-20 280 128 190l110 45 102-70 240 86" fill="none" stroke="#e4d4be" stroke-width="34" />
          <path d="M64-20 146 112l-32 88 54 154" fill="none" stroke="#e4d4be" stroke-width="20" />
          <path d="M370-20 344 96l91 60-21 188" fill="none" stroke="#e4d4be" stroke-width="24" />
          <path d="M-20 105 120 82l84 46 130-28 246 44" fill="none" stroke="#d8e6cc" stroke-width="14" />
          <path d="M-20 330 150 302l130 26 280-42" fill="none" stroke="#e4d4be" stroke-width="12" />
          <rect x="186" y="160" width="94" height="72" rx="8" fill="#efe0cb" />
          <rect x="420" y="246" width="88" height="68" rx="8" fill="#efe0cb" />
          <rect x="282" y="62" width="48" height="42" rx="6" fill="#efe0cb" />
          <circle cx="282" cy="188" r="58" fill="#e36c8a" opacity=".12" />
          <circle cx="282" cy="188" r="38" fill="#e36c8a" opacity=".2" />
          <path
            d="M282 148c-14 0-25 11-25 25 0 19 25 45 25 45s25-26 25-45c0-14-11-25-25-25Z"
            fill="#2d1674"
          />
          <circle cx="282" cy="174" r="8" fill="#faf4e9" />
          <text x="318" y="190" fill="#2d1674" font-family="Georgia, serif" font-size="19" font-style="italic">Heal &amp; Heed</text>
          <text x="318" y="211" fill="#72667a" font-family="Helvetica, Arial, sans-serif" font-size="11" letter-spacing="1">L.B. NAGAR</text>
        </svg>
        <span class="visit__map-label">
          <span>Open in Google Maps</span>
          <Icon name="arrow" size={14} />
        </span>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--cream faq-section">
    <div class="container faq-section__inner">
      <div class="faq-section__intro reveal">
        <span class="eyebrow">Before you call</span>
        <h2>Small questions, <em>clear answers.</em></h2>
        <p class="lead">
          If your question is not here, call or WhatsApp us. We would rather
          answer it than have you wonder.
        </p>
        <a class="text-link" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
          Ask us on WhatsApp
          <Icon name="arrow" size={14} />
        </a>
      </div>
      <div class="faq-section__list reveal" style="--reveal-delay:120ms">
        <FaqList items={contactFaqs} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!contactForm.reportValidity()) return;

    const data = new FormData(contactForm);
    const name = String(data.get('name') ?? '').trim();
    const age = String(data.get('age') ?? '').trim();
    const interest = String(data.get('interest') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    const lines = [
      `Hi Heal & Heed, my name is ${name}.`,
      age ? `My child is ${age} years old.` : '',
      `I'm interested in: ${interest}.`,
      message ? `A little more: ${message}` : '',
      'Could you please help me with the next step?',
    ].filter(Boolean);

    const url = `https://wa.me/917416848323?text=${encodeURIComponent(lines.join('\n\n'))}`;
    const status = contactForm.querySelector<HTMLElement>('[data-form-status]');

    if (status) {
      status.textContent =
        'Opening WhatsApp in a new tab with your message ready to send.';
    }

    const opened = window.open(url, '_blank', 'noopener,noreferrer');
    if (!opened) window.location.href = url;
  });
</script>

<style>
/* Hero */
  .contact-hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }
.contact-hero__chips span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 253, 249, 0.65);
    color: var(--ink-soft);
    font-size: 0.64rem;
    font-weight: 600;
  }
.contact-hero__chips :global(svg) {
    color: var(--pink-deep);
  }
/* Contact cards */
  .contact-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
  }
.contact-card {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: clamp(1.1rem, 2.2vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
.contact-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }
.contact-card__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 0.3rem;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.contact-card__label {
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
.contact-card strong {
    color: var(--purple);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    font-weight: 500;
    line-height: 1.2;
  }
.contact-card p {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.55;
  }
.contact-card .text-link {
    margin-top: 0.35rem;
    align-self: end;
    font-size: 0.7rem;
  }
/* Form */
  .contact-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(280px, 0.88fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
.contact-form-wrap {
    display: grid;
    gap: 0.9rem;
    max-width: 650px;
  }
.contact-form-wrap h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.contact-form-wrap__lead {
    max-width: 54ch;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }
.contact-form {
    display: grid;
    gap: 1rem;
    margin-top: 0.8rem;
    padding: clamp(1.4rem, 2.8vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--cream-light);
  }
.contact-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
.field {
    display: grid;
    gap: 0.35rem;
  }
.field > span {
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
.field > span em {
    color: var(--pink-deep);
    font-style: normal;
  }
.field input, .field select, .field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--white);
    color: var(--ink);
    font-size: 0.82rem;
    line-height: 1.5;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
.field textarea {
    resize: vertical;
    min-height: 120px;
  }
.field input::placeholder, .field textarea::placeholder {
    color: rgba(114, 102, 122, 0.6);
  }
.field input:focus, .field select:focus, .field textarea:focus {
    outline: none;
    border-color: var(--pink);
    box-shadow: 0 0 0 3px rgba(227, 108, 138, 0.15);
  }
.contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.3rem;
  }
.contact-form__note {
    max-width: 34ch;
    color: var(--muted);
    font-size: 0.64rem;
    line-height: 1.5;
  }
.contact-form__status {
    min-height: 1.2em;
    color: var(--sage-ink);
    font-size: 0.7rem;
    font-weight: 500;
  }
/* Side */
  .contact-side {
    display: grid;
    gap: 0.9rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
.contact-side__panel {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: var(--radius-lg);
    background: var(--purple);
    color: var(--cream-light);
  }
.contact-side__panel .eyebrow {
    color: var(--pink);
  }
.contact-side__panel h2 {
    margin-top: 0.7rem;
    color: var(--cream-light);
    font-size: clamp(1.9rem, 2.8vw, 2.6rem);
  }
.contact-side__panel h2 em {
    color: var(--pink);
    font-style: italic;
  }
.next-steps {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }
.next-steps li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 0.7rem;
    align-items: start;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 250, 242, 0.14);
  }
.next-steps li > span {
    color: var(--pink);
    font-family: var(--font-serif);
    font-size: 0.7rem;
    font-style: italic;
  }
.next-steps h3 {
    color: var(--cream-light);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
  }
.next-steps p {
    margin-top: 0.2rem;
    color: rgba(255, 250, 242, 0.64);
    font-size: 0.72rem;
    line-height: 1.6;
  }
.contact-side__call {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 250, 242, 0.14);
  }
.contact-side__call :global(svg) {
    color: var(--pink);
  }
.contact-side__call small {
    display: block;
    color: rgba(255, 250, 242, 0.55);
    font-size: 0.6rem;
  }
.contact-side__call a {
    color: var(--cream-light);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    text-decoration: none;
  }
.hours-card {
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
.hours-card__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
.hours-card__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.hours-card h3 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
  }
.hours-card ul {
    display: grid;
    gap: 0.5rem;
  }
.hours-card li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.7rem;
  }
.hours-card li strong {
    color: var(--purple);
    font-weight: 600;
    white-space: nowrap;
  }
.hours-card > p {
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.66rem;
    line-height: 1.55;
  }
/* Visit */
  .visit {
    position: relative;
    overflow: clip;
  }
.visit__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
.visit__copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 520px;
  }
.visit__copy h2 em {
    color: var(--purple);
    font-style: italic;
  }
.visit__copy address {
    color: var(--sage-ink);
    font-size: 0.86rem;
    line-height: 1.8;
  }
.visit__map {
    display: grid;
    gap: 0.7rem;
    color: var(--purple);
    text-decoration: none;
  }
.visit__map svg {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform 0.3s var(--ease);
  }
.visit__map:hover svg {
    transform: translateY(-3px);
  }
.visit__map-label {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    color: var(--purple);
    font-size: 0.7rem;
    font-weight: 600;
  }
:global(.visit__giraffe) {
    width: clamp(80px, 10vw, 140px);
    right: 2%;
    bottom: 2%;
    color: var(--sage-ink);
    opacity: 0.28;
  }
:global(.visit__sun) {
    width: clamp(45px, 6vw, 76px);
