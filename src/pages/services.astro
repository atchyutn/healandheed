---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Doodle from '../components/Doodle.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { images } from '../lib/images';
import { careFormats, services } from '../data/services';
import { servicesFaqs } from '../data/faqs';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema, webPageSchema } from '../lib/schema';

const description =
  'Occupational therapy, behaviour therapy, speech therapy and special education for children in L.B. Nagar, Hyderabad. Personalised plans, in-person and online support.';

const serviceListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Child development and rehabilitation services',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      description: service.summary,
      url: new URL(`/services/#${service.slug}`, site.url).href,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: { '@type': 'City', name: 'Hyderabad' },
    },
  })),
};

const schemas = [
  webPageSchema({
    name: 'Child development and rehabilitation services',
    description,
    path: '/services/',
    type: 'CollectionPage',
  }),
  serviceListSchema,
  faqSchema(servicesFaqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
  ]),
];
---

<BaseLayout
  title="Our services — Therapy and special education for children"
  description={description}
  jsonLd={schemas}
>
  <PageHero
    eyebrow="Specialised care"
    title="The right support,"
    accent="at the right time."
    lead="Four core therapies, one connected team. We start by understanding your child, then build a practical plan that fits your family’s everyday life."
    image={images.kid}
    imageAlt="Illustration of a child playing with a toy car"
    imageTone="pink"
    badge="Occupational · Behaviour · Speech · Special education"
  >
    <div class="button-row hero-actions">
      <a class="btn" href="/online-sessions/">
        Book a consultation
        <Icon name="arrow" size={15} />
      </a>
      <a class="btn btn--secondary" href="#occupational-therapy">Explore the services</a>
    </div>
  </PageHero>

  <!-- Quick links -->
  <section class="section section--cream section--tight services-intro">
    <div class="container">
      <div class="services-intro__inner">
        <div class="services-intro__copy reveal">
          <span class="eyebrow">Where to begin</span>
          <h2>You do not need to know <em>which therapy.</em></h2>
          <p class="lead">
            Start with what you have noticed. We will help you make sense of it,
            explain the options clearly and recommend a plan — including which
            therapy or combination of therapies may help.
          </p>
        </div>

        <nav class="service-jump reveal" aria-label="Our services" style="--reveal-delay:100ms">
          {services.map((service) => (
            <a href={`#${service.slug}`}>
              <span class:list={['service-jump__icon', `service-jump__icon--${service.accent}`]}>
                <Icon name={service.icon} size={18} />
              </span>
              <span>
                <strong>{service.title}</strong>
                <small>{service.short}</small>
              </span>
              <Icon name="arrow" size={15} />
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- Service details -->
  {
    services.map((service, index) => (
      <section
        class:list={[
          'section',
          index % 2 === 0 ? 'section--white' : 'section--cream',
          'service-section',
        ]}
        id={service.slug}
      >
        <div class:list={['service-section__wash', `service-section__wash--${service.accent}`]} aria-hidden="true" />
        <Doodle type={index % 2 === 0 ? 'sparkle' : 'flower'} class="service-section__doodle" />
        <div class="container service-row">
          <div class="service-row__head reveal">
            <span class="service-row__index">0{index + 1} / 04</span>
            <span class:list={['service-row__icon', `service-row__icon--${service.accent}`]}>
              <Icon name={service.icon} size={28} />
            </span>
            <h2>{service.title}</h2>
            <p class="service-row__short">{service.short}</p>
          </div>

          <div class="service-row__body reveal" style="--reveal-delay:120ms">
            <p class="lead">{service.summary}</p>
            <ul class="service-bullets">
              {service.bullets.map((bullet) => (
                <li>
                  <Icon name="check" size={12} />
                  {bullet}
                </li>
              ))}
            </ul>
            <div class="service-row__actions">
              <a class="btn" href="/online-sessions/">
                Ask about {service.title.toLowerCase()}
                <Icon name="arrow" size={15} />
              </a>
              <span class="service-row__format">
                <Icon name="pin" size={14} />
                In-person at our L.B. Nagar centre
              </span>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- Care formats -->
  <section class="section section--sage formats">
    <Doodle type="sun" class="formats__sun" />
    <Doodle type="leaf" class="formats__leaf" />
    <div class="container">
      <SectionHeading
        eyebrow="Care that fits your family"
        title="Different settings."
        accent="One consistent team."
        lead="Therapy should work around your life, not the other way around. Ask us which format is the best fit for your child."
      />

      <div class="formats-grid">
        {careFormats.map((format, index) => (
          <article class="format-card reveal" style={`--reveal-delay:${index * 65}ms`}>
            <span class="format-card__icon"><Icon name={format.icon} size={22} /></span>
            <span class="format-card__number">0{index + 1}</span>
            <h3>{format.title}</h3>
            <p>{format.text}</p>
          </article>
        ))}
      </div>

      <p class="formats__note reveal">
        Not sure which setting suits your child? Call us on
        <a href={site.phoneHref}>{site.phone}</a> and we will talk it through.
      </p>
    </div>
  </section>

  <!-- Assessment path -->
  <section class="section section--white assessment">
    <div class="container grid-2">
      <div class="assessment__copy reveal">
        <span class="eyebrow">Assessment first</span>
        <h2>We plan from what <em>we learn.</em></h2>
        <p class="lead">
          A good plan starts with a clear picture. Before we recommend a therapy
          or a schedule, we take time to understand your child’s strengths,
          needs and the goals that matter to your family.
        </p>
        <p>
          You will leave with an explanation you can understand, not a folder of
          jargon. If something is not clear, ask again. Shared understanding is
          part of the care.
        </p>

        <ul class="check-list assessment__list">
          <li>A conversation about what you have noticed</li>
          <li>An assessment suited to your child’s needs</li>
          <li>A written plan with realistic next steps</li>
          <li>Regular review as your child grows</li>
        </ul>

        <a class="btn" href="/contact/">
          Start with a conversation
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div class="assessment__visual reveal" style="--reveal-delay:120ms">
        <div class="assessment__card">
          <span class="assessment__kicker">A plan is working when</span>
          <ul>
            <li>
              <span>01</span>
              Your child feels understood
            </li>
            <li>
              <span>02</span>
              You know what to do at home
            </li>
            <li>
              <span>03</span>
              Progress shows up in daily life
            </li>
            <li>
              <span>04</span>
              The team adjusts as needs change
            </li>
          </ul>
        </div>
        <div class="assessment__quote">
          <Icon name="heart" size={18} />
          <p>Therapy is a partnership, not a prescription.</p>
        </div>
        <Doodle type="giraffe" class="assessment__giraffe" />
      </div>
    </div>
  </section>

  <!-- Group therapy callout -->
  <section class="section section--pink-solid group-callout">
    <div class="container group-callout__inner">
      <div class="group-callout__copy reveal">
        <span class="eyebrow">More than one-to-one</span>
        <h2>Learning to connect, <em>together.</em></h2>
        <p class="lead">
          Group therapy gives children a safe, structured place to practise
          turn-taking, listening, movement and communication with peers.
        </p>
        <div class="button-row">
          <a class="btn" href="/group-therapies/">
            Explore group therapy
            <Icon name="arrow" size={15} />
          </a>
          <a class="btn btn--secondary" href="/summer-program/">
            See the summer programme
          </a>
        </div>
      </div>

      <div class="group-callout__list reveal" style="--reveal-delay:120ms">
        <div><Icon name="users" size={18} /><span>Turn-taking and shared attention</span></div>
        <div><Icon name="chat" size={18} /><span>Communication in a real group</span></div>
        <div><Icon name="puzzle" size={18} /><span>Movement, play and problem-solving</span></div>
        <div><Icon name="heart" size={18} /><span>Confidence with other children</span></div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section section--white faq-section">
    <div class="container faq-section__inner">
      <div class="faq-section__intro reveal">
        <span class="eyebrow">Good to know</span>
        <h2>Before you <em>begin.</em></h2>
        <p class="lead">
          A few questions families ask when they are deciding where to start.
        </p>
        <a class="text-link" href="/contact/">
          Ask us something else
          <Icon name="arrow" size={14} />
        </a>
      </div>
      <div class="faq-section__list reveal" style="--reveal-delay:120ms">
        <FaqList items={servicesFaqs} />
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Ready when you are"
    title="Let’s find the right"
    accent="next step."
    text="Tell us what you have noticed and what you are hoping for. We will listen, explain the options and help you choose a plan that fits your child."
    primaryLabel="Book a consultation"
    secondaryLabel="Call our team"
  />
</BaseLayout>

<style>
.hero-actions {
    margin-top: 0.6rem;
  }
/* Intro */
  .services-intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
.services-intro__copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 560px;
  }
.services-intro__copy h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.service-jump {
    display: grid;
    gap: 0.55rem;
  }
.service-jump a {
    display: grid;
    grid-template-columns: 42px 1fr 20px;
    gap: 0.85rem;
    align-items: center;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    text-decoration: none;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
.service-jump a:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-sm);
  }
.service-jump__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.service-jump__icon--sage {
    background: var(--sage);
    color: var(--sage-ink);
  }
.service-jump__icon--gold {
    background: var(--gold-soft);
    color: #7f5a1f;
  }
.service-jump__icon--plum {
    background: rgba(45, 22, 116, 0.09);
    color: var(--purple);
  }
.service-jump strong, .service-jump small {
    display: block;
  }
.service-jump strong {
    color: var(--purple);
    font-size: 0.8rem;
    font-weight: 600;
  }
.service-jump small {
    margin-top: 0.1rem;
    color: var(--muted);
    font-size: 0.68rem;
  }
.service-jump a > :global(svg:last-child) {
    color: var(--pink-deep);
  }
/* Service rows */
  .service-section {
    position: relative;
    overflow: clip;
  }
.service-section__wash {
    position: absolute;
    top: -10%;
    right: -8%;
    width: clamp(260px, 34vw, 460px);
    height: clamp(260px, 32vw, 430px);
    border-radius: 48% 52% 45% 55% / 42% 40% 60% 58%;
    opacity: 0.35;
    pointer-events: none;
  }
.service-section__wash--pink {
    background: var(--pink-soft);
  }
.service-section__wash--sage {
    background: var(--sage);
  }
.service-section__wash--gold {
    background: var(--gold-soft);
  }
.service-section__wash--plum {
    background: rgba(45, 22, 116, 0.08);
  }
:global(.service-section__doodle) {
    width: clamp(42px, 5vw, 72px);
    left: 4%;
    bottom: 10%;
    opacity: 0.45;
  }
.service-row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
.service-row__head {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 430px;
  }
.service-row__index {
    color: var(--pink-deep);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-style: italic;
    letter-spacing: 0.08em;
  }
.service-row__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.service-row__icon--sage {
    background: var(--sage);
    color: var(--sage-ink);
  }
.service-row__icon--gold {
    background: var(--gold-soft);
    color: #7f5a1f;
  }
.service-row__icon--plum {
    background: rgba(45, 22, 116, 0.09);
    color: var(--purple);
  }
.service-row__head h2 {
    font-size: clamp(2.1rem, 3.8vw, 3.35rem);
  }
.service-row__short {
    color: var(--pink-deep);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    font-style: italic;
  }
.service-row__body {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 640px;
  }
.service-bullets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
    width: 100%;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
.service-bullets li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.55rem;
    align-items: start;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.6;
  }
.service-bullets :global(svg) {
    margin-top: 0.2rem;
    color: var(--pink-deep);
  }
.service-row__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
.service-row__format {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.7rem;
  }
.service-row__format :global(svg) {
    color: var(--pink-deep);
  }
/* Formats */
  .formats {
    position: relative;
    overflow: clip;
  }
.formats-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
.format-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.3rem, 2.4vw, 1.9rem);
    border-radius: var(--radius);
    background: rgba(255, 253, 249, 0.6);
    overflow: hidden;
    transition: background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
.format-card:hover {
    background: var(--cream-light);
    transform: translateY(-3px);
  }
.format-card__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.format-card__number {
    position: absolute;
    top: 1rem;
    right: 1.1rem;
    color: rgba(45, 22, 116, 0.16);
    font-family: var(--font-serif);
    font-size: 2.1rem;
    font-style: italic;
    line-height: 1;
  }
.format-card h3 {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }
.format-card p {
    color: var(--sage-ink);
    font-size: 0.78rem;
    line-height: 1.65;
  }
.formats__note {
    position: relative;
    z-index: 1;
    margin-top: 1.6rem;
    color: var(--sage-ink);
    font-size: 0.82rem;
    text-align: center;
  }
.formats__note a {
    color: var(--purple);
    font-weight: 600;
  }
:global(.formats__sun) {
    width: clamp(50px, 6vw, 84px);
    top: 12%;
    right: 6%;
    color: var(--gold);
    opacity: 0.7;
  }
:global(.formats__leaf) {
    width: clamp(55px, 7vw, 95px);
    left: 3%;
    bottom: 8%;
    color: var(--sage-ink);
    opacity: 0.35;
  }
/* Assessment */
  .assessment__copy {
    display: grid;
    justify-items: start;
    gap: 1.05rem;
    max-width: 560px;
  }
.assessment__copy h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.assessment__copy p:not(.lead) {
    color: var(--muted);
    font-size: 0.92rem;
  }
.assessment__list {
    margin-block: 0.4rem;
  }
.assessment__visual {
    position: relative;
    max-width: 470px;
    margin-inline: auto;
    width: 100%;
    padding: 1rem 0;
    isolation: isolate;
  }
.assessment__card {
    position: relative;
    z-index: 1;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    padding-bottom: clamp(6rem, 7.5vw, 7rem);
    border-radius: var(--radius-lg);
    background: var(--purple);
    color: var(--cream-light);
    box-shadow: var(--shadow);
    transform: rotate(-2deg);
  }
.assessment__kicker {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--pink);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
.assessment__card ul {
    display: grid;
    gap: 0.85rem;
  }
.assessment__card li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 0.75rem;
    align-items: start;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 250, 242, 0.14);
    color: var(--cream-light);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.35;
  }
.assessment__card li span {
    color: var(--pink);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }
.assessment__quote {
    position: absolute;
    z-index: 2;
    right: -0.5rem;
    bottom: 7%;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 230px;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: var(--pink-soft);
    box-shadow: var(--shadow-sm);
    transform: rotate(2deg);
  }
.assessment__quote :global(svg) {
    flex: 0 0 auto;
    color: var(--pink-deep);
  }
.assessment__quote p {
    color: var(--purple);
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.4;
  }
:global(.assessment__giraffe) {
    width: clamp(60px, 8vw, 105px);
    left: -3%;
    top: 2%;
    color: var(--sage-deep);
    opacity: 0.5;
  }
/* Group callout */
  .group-callout__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
.group-callout__copy {
    display: grid;
    justify-items: start;
    gap: 1.05rem;
    max-width: 620px;
  }
.group-callout__copy h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.group-callout__list {
    display: grid;
    gap: 0.6rem;
  }
.group-callout__list div {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 253, 249, 0.55);
    color: var(--purple);
    font-size: 0.82rem;
    font-weight: 500;
  }
.group-callout__list :global(svg) {
    flex: 0 0 auto;
    color: var(--pink-deep);
  }
/* FAQ */
  .faq-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
.faq-section__intro {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 430px;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
.faq-section__intro h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.faq-section__list :global(.faq-list) {
    margin-inline: 0;
  }

  @media (max-width: 1024px) {
.formats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
.services-intro__inner, .service-row, .group-callout__inner, .faq-section__inner {
      grid-template-columns: 1fr;
    }
.service-row__head {
      max-width: none;
    }
.service-bullets {
      grid-template-columns: 1fr;
    }
.faq-section__intro {
      position: static;
      max-width: none;
    }
.assessment__visual {
      max-width: 520px;
    }
  }

  @media (max-width: 640px) {
.formats-grid {
      grid-template-columns: 1fr;
    }
.service-row__actions {
      align-items: flex-start;
      flex-direction: column;
    }
.assessment__quote {
      right: 0;
    }
  }
</style>
