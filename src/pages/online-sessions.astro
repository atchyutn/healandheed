---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtPanel from '../components/ArtPanel.astro';
import CtaBand from '../components/CtaBand.astro';
import Doodle from '../components/Doodle.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema, webPageSchema } from '../lib/schema';

const description =
  'Book an online behaviour therapy session with Heal & Heed. Personalised online support for children and parents in Hyderabad and beyond.';

const onlineFaqs = [
  {
    q: 'Is online therapy as effective as in-person therapy?',
    a: 'For many behaviour goals, online sessions work well because the home environment is part of the plan. We will be honest with you if we think your child would benefit more from in-person support.',
  },
  {
    q: 'Which service is available online?',
    a: 'Online sessions are currently available for behaviour therapy. If you are looking for occupational therapy, speech therapy or special education online, call us and we will talk through the options.',
  },
  {
    q: 'What do we need for a session?',
    a: 'A quiet room, a stable internet connection and a device with a camera and microphone. We will share the meeting link once your booking is confirmed, along with anything else you should prepare.',
  },
  {
    q: 'Can both parents join the session?',
    a: 'Yes. We welcome both parents or caregivers where possible. Consistency at home matters, and it helps when everyone hears the same guidance.',
  },
  {
    q: 'How do I reschedule an appointment?',
    a: 'Use the reschedule link in your Calendly confirmation email. If you are having trouble, call or WhatsApp us and we will help you find another time.',
  },
];

const onlineServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Online Behaviour Therapy for Children',
  description,
  provider: { '@id': `${site.url}/#organization` },
  serviceType: 'Online behaviour therapy',
  areaServed: { '@type': 'Country', name: 'India' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `${site.url}/online-sessions/`,
    availableLanguage: ['English', 'Telugu', 'Hindi'],
  },
};

const schemas = [
  webPageSchema({
    name: 'Online behaviour therapy sessions',
    description,
    path: '/online-sessions/',
    type: 'MedicalWebPage',
  }),
  onlineServiceSchema,
  faqSchema(onlineFaqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Online sessions', path: '/online-sessions/' },
  ]),
];

const steps = [
  {
    number: '01',
    title: 'Choose a time',
    text: 'Open the booking calendar and pick an appointment that fits your week. You will receive a confirmation with the meeting details.',
    icon: 'calendar',
  },
  {
    number: '02',
    title: 'Tell us what you have noticed',
    text: 'The first conversation is about understanding your child, your questions and the goals that matter most to your family.',
    icon: 'chat',
  },
  {
    number: '03',
    title: 'Meet from home',
    text: 'Join the video call from a quiet space. We work with you and your child on practical strategies that fit your everyday routines.',
    icon: 'video',
  },
  {
    number: '04',
    title: 'Carry it into the week',
    text: 'You leave with clear next steps, not a list of theory. We review what is working and adjust the plan together.',
    icon: 'home',
  },
];
---

<BaseLayout
  title="Online behaviour therapy — Book a session"
  description={description}
  jsonLd={schemas}
>
  <PageHero
    eyebrow="Online sessions"
    breadcrumb="Online sessions"
    title="Support that comes"
    accent="to you."
    lead="Online behaviour therapy for families who cannot travel, or who feel more comfortable at home. The same thoughtful planning and parent partnership — from wherever you are."
    imageTone="gold"
    badge="Online behaviour therapy · Hyderabad & beyond"
  >
    <ArtPanel
      slot="visual"
      layout="orbit"
      tone="gold"
      centerIcon="video"
      items={[
        { icon: 'chat' },
        { icon: 'home' },
        { icon: 'calendar' },
        { icon: 'shield' },
      ]}
      eyebrow="From your home"
      title="The same care, on a screen."
    />
    <div class="button-row hero-actions">
      <a class="btn" href="#book">
        Book an online session
        <Icon name="calendar" size={15} />
      </a>
      <a class="btn btn--secondary" href={site.phoneHref}>
        <Icon name="phone" size={15} />
        {site.phone}
      </a>
    </div>
  </PageHero>

  <!-- How it works -->
  <section class="section section--cream online-how">
    <div class="container">
      <SectionHeading
        eyebrow="How it works"
        title="A simple way"
        accent="to begin."
        lead="No complicated setup. Choose a time, meet us online and leave with a clear next step for home."
      />

      <div class="online-steps">
        {steps.map((step, index) => (
          <article class="online-step reveal" style={`--reveal-delay:${index * 65}ms`}>
            <div class="online-step__top">
              <span class="online-step__number">{step.number}</span>
              <span class="online-step__icon"><Icon name={step.icon} size={19} /></span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>

      <div class="online-how__note reveal">
        <Icon name="heart" size={18} />
        <p>
          Online sessions are currently offered for <strong>behaviour therapy</strong>.
          For other services, call us and we will help you find the right format.
        </p>
      </div>
    </div>
  </section>

  <!-- Booking -->
  <section class="section section--white booking" id="book">
    <div class="booking__blob blob blob--pink"></div>
    <div class="container booking__grid">
      <div class="booking__copy reveal">
        <span class="eyebrow">Book your session</span>
        <h2>Pick a time that <em>works for you.</em></h2>
        <p class="lead">
          Appointments are booked directly through Calendly. Choose a slot and
          you will receive a confirmation with everything you need to join.
        </p>

        <div class="booking__details">
          <div class="booking-detail">
            <span class="booking-detail__icon"><Icon name="video" size={18} /></span>
            <span>
              <strong>Online video session</strong>
              <small>A meeting link is shared after booking.</small>
            </span>
          </div>
          <div class="booking-detail">
            <span class="booking-detail__icon"><Icon name="calendar" size={18} /></span>
            <span>
              <strong>Behaviour therapy</strong>
              <small>For children and their parents or caregivers.</small>
            </span>
          </div>
          <div class="booking-detail">
            <span class="booking-detail__icon"><Icon name="clock" size={18} /></span>
            <span>
              <strong>Appointment length</strong>
              <small>Confirmed when you choose a slot.</small>
            </span>
          </div>
          <div class="booking-detail">
            <span class="booking-detail__icon"><Icon name="phone" size={18} /></span>
            <span>
              <strong>Prefer to talk first?</strong>
              <small><a href={site.phoneHref}>Call {site.phone}</a> or <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp us</a>.</small>
            </span>
          </div>
        </div>

        <div class="booking__before">
          <h3>Before your first session</h3>
          <ul class="check-list">
            <li>Find a quiet, private space with a stable internet connection</li>
            <li>Have a notebook ready for questions and strategies</li>
            <li>Let us know if your child will be joining the call</li>
            <li>Keep the confirmation email handy for the meeting link</li>
          </ul>
        </div>
      </div>

      <div class="booking__widget reveal" style="--reveal-delay:120ms">
        <div
          class="calendly-frame"
          data-calendly
          data-calendly-src={`${site.calendly}?hide_gdpr_banner=1&primary_color=c94f70`}
        >
          <div class="calendly-placeholder">
            <div class="calendly-placeholder__top">
              <span class="calendly-placeholder__logo">
                <Icon name="calendar" size={26} strokeWidth={1.5} />
              </span>
              <span class="pill pill--pink">Booking calendar</span>
            </div>
            <h3>Choose your appointment</h3>
            <p>
              The calendar is loaded only when you need it, so the page stays
              quick. You can also open it in a new tab.
            </p>
            <div class="calendly-placeholder__actions">
              <button class="btn" type="button" data-calendly-load>
                Load booking calendar
                <Icon name="calendar" size={16} />
              </button>
              <a
                class="text-link"
                href={site.calendly}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open in a new tab
                <Icon name="arrow" size={14} />
              </a>
            </div>
            <span class="calendly-placeholder__note">
              <Icon name="shield" size={14} />
              Bookings are handled securely by Calendly.
            </span>
          </div>
        </div>
        <p class="booking__fallback">
          Having trouble loading the calendar? <a href={site.calendly} target="_blank" rel="noopener noreferrer">Open the booking page</a> or call us on <a href={site.phoneHref}>{site.phone}</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- What online support can help with -->
  <section class="section section--sage online-help">
    <Doodle type="flower" class="online-help__flower" />
    <Doodle type="sun" class="online-help__sun" />
    <div class="container">
      <SectionHeading
        eyebrow="What we can work on"
        title="Practical support,"
        accent="where it matters."
        lead="Online behaviour therapy is most useful when the strategies fit the place they will be used: your home."
      />

      <div class="help-grid">
        <article class="help-card reveal">
          <span class="help-card__icon"><Icon name="home" size={21} /></span>
          <h3>Everyday behaviour at home</h3>
          <p>Morning routines, transitions, mealtimes and the moments that feel hardest — planned for with you, not at you.</p>
        </article>
        <article class="help-card reveal" style="--reveal-delay:70ms">
          <span class="help-card__icon"><Icon name="chat" size={21} /></span>
          <h3>Communication and big feelings</h3>
          <p>Helping your child express what they need and helping you respond in a way that lowers the temperature.</p>
        </article>
        <article class="help-card reveal" style="--reveal-delay:140ms">
          <span class="help-card__icon"><Icon name="users" size={21} /></span>
          <h3>Social skills and confidence</h3>
          <p>Practical ideas for turn-taking, sharing and playing with others, practised in the environments your child knows.</p>
        </article>
        <article class="help-card reveal" style="--reveal-delay:210ms">
          <span class="help-card__icon"><Icon name="link" size={21} /></span>
          <h3>Parent strategies that stick</h3>
          <p>Clear language, consistent responses and a plan you can actually keep using after the session ends.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--white faq-section">
    <div class="container faq-section__inner">
      <div class="faq-section__intro reveal">
        <span class="eyebrow">Good to know</span>
        <h2>Questions about <em>online care.</em></h2>
        <p class="lead">
          If something is not answered here, call or WhatsApp us. We would rather
          answer a question than have you guess.
        </p>
        <div class="faq-section__contact">
          <a class="text-link" href={site.phoneHref}>
            <Icon name="phone" size={14} />
            {site.phone}
          </a>
          <a class="text-link" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={14} />
            WhatsApp us
          </a>
        </div>
      </div>
      <div class="faq-section__list reveal" style="--reveal-delay:120ms">
        <FaqList items={onlineFaqs} />
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="No pressure, just a conversation"
    title="Not sure if online"
    accent="is right?"
    text="Call us and tell us a little about your child. We will be honest about whether online behaviour therapy is a good fit, and what else might help."
    primaryLabel="Book a session"
    secondaryLabel="WhatsApp our team"
    secondaryHref={site.whatsapp}
  />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-calendly]').forEach((frame) => {
    const button = frame.querySelector<HTMLButtonElement>('[data-calendly-load]');
    const src = frame.dataset.calendlySrc;

    button?.addEventListener('click', () => {
      if (!src) return;

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'Book an online behaviour therapy session with Heal and Heed';
      iframe.loading = 'lazy';
      iframe.setAttribute('allow', 'fullscreen');
      iframe.addEventListener('load', () => frame.classList.add('is-loaded'));

      frame.replaceChildren(iframe);
    });
  });
</script>

<style>
.hero-actions {
    margin-top: 0.6rem;
  }
/* How it works */
  .online-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
.online-step {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.3rem, 2.4vw, 1.9rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
.online-step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }
.online-step__number {
    color: rgba(45, 22, 116, 0.2);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-style: italic;
    line-height: 1;
  }
.online-step__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.online-step h3 {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }
.online-step p {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }
.online-how__note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 760px;
    margin: 1.6rem auto 0;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--pink-soft);
  }
.online-how__note :global(svg) {
    flex: 0 0 auto;
    margin-top: 0.15rem;
    color: var(--pink-deep);
  }
.online-how__note p {
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.6;
  }
/* Booking */
  .booking {
    position: relative;
  }
.booking__blob {
    width: clamp(280px, 42vw, 620px);
    height: clamp(260px, 38vw, 520px);
    right: -12%;
    top: 4%;
    opacity: 0.5;
  }
.booking__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
.booking__copy {
    display: grid;
    justify-items: start;
    gap: 1.2rem;
  }
.booking__copy h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.booking__details {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    margin-block: 0.25rem;
  }
.booking-detail {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 0.8rem;
    align-items: start;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
  }
.booking-detail__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.booking-detail strong, .booking-detail small {
    display: block;
  }
.booking-detail strong {
    color: var(--purple);
    font-size: 0.78rem;
    font-weight: 600;
  }
.booking-detail small {
    margin-top: 0.12rem;
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.5;
  }
.booking-detail a {
    color: var(--pink-deep);
  }
.booking__before {
    width: 100%;
    margin-top: 0.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }
.booking__before h3 {
    margin-bottom: 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
.booking__before :global(.check-list) {
    gap: 0.55rem;
  }
.booking__before :global(.check-list li) {
    font-size: 0.82rem;
  }
.booking__widget {
    display: grid;
    gap: 0.8rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
.calendly-frame {
    position: relative;
    min-height: 600px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--cream-light);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
.calendly-frame iframe {
    width: 100%;
    height: 680px;
    border: 0;
    display: block;
  }
.calendly-placeholder {
    display: grid;
    align-content: start;
    gap: 1rem;
    height: 100%;
    min-height: inherit;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    background:
      radial-gradient(circle at 82% 12%, rgba(201, 220, 187, 0.55), transparent 38%),
      radial-gradient(circle at 12% 84%, rgba(247, 216, 224, 0.8), transparent 42%),
      var(--cream-light);
  }
.calendly-placeholder__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
.calendly-placeholder__logo {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--pink-soft);
  }
.calendly-placeholder__logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
.calendly-placeholder h3 {
    margin-top: 1rem;
    font-size: clamp(1.8rem, 2.0vw, 2.4rem);
  }
.calendly-placeholder > p {
    max-width: 42ch;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }
.calendly-placeholder__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-block: 0.4rem;
  }
.calendly-placeholder__note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.66rem;
  }
.calendly-placeholder__note :global(svg) {
    color: var(--sage-ink);
  }
.booking__fallback {
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.6;
    text-align: center;
  }
.booking__fallback a {
    color: var(--pink-deep);
  }
/* Help */
  .online-help {
    position: relative;
    overflow: clip;
  }
.help-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
.help-card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    border-radius: var(--radius);
    background: rgba(255, 253, 249, 0.62);
    transition: background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
.help-card:hover {
    background: var(--cream-light);
    transform: translateY(-3px);
  }
.help-card__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.help-card h3 {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }
.help-card p {
    color: var(--sage-ink);
    font-size: 0.8rem;
    line-height: 1.68;
  }
:global(.online-help__flower) {
    width: clamp(50px, 6vw, 82px);
    right: 4%;
    bottom: 6%;
    color: var(--pink-deep);
    opacity: 0.35;
  }
:global(.online-help__sun) {
    width: clamp(48px, 6vw, 78px);
    left: 4%;
    top: 8%;
    color: var(--gold);
    opacity: 0.7;
  }
/* FAQ */
  .faq-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
.faq-section__intro {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 430px;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
.faq-section__intro h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.faq-section__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.2rem;
    margin-top: 0.4rem;
  }
.faq-section__list :global(.faq-list) {
    margin-inline: 0;
  }

  @media (max-width: 1024px) {
.online-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
.online-steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
.booking__grid, .faq-section__inner {
      grid-template-columns: 1fr;
    }
.booking__widget, .faq-section__intro {
      position: static;
    }
.calendly-frame {
      min-height: 540px;
    }
.calendly-frame iframe {
      height: 620px;
    }
  }

  @media (max-width: 640px) {
.help-grid {
      grid-template-columns: 1fr;
    }
.calendly-frame {
      min-height: 0;
    }
.calendly-placeholder {
      min-height: 480px;
    }
.calendly-frame iframe {
      height: 640px;
    }
  }
</style>
