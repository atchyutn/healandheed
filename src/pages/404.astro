---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import Icon from '../components/Icon.astro';
import { images } from '../lib/images';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found. Explore Heal & Heed’s services, summer programme or contact our team."
  canonical="/404.html"
  noindex
>
  <section class="not-found grid-lines">
    <div class="not-found__blob blob blob--pink"></div>
    <Doodle type="butterfly" class="not-found__doodle not-found__doodle--one" />
    <Doodle type="sparkle" class="not-found__doodle not-found__doodle--two" />
    <Doodle type="giraffe" class="not-found__doodle not-found__doodle--three" />

    <div class="container not-found__inner">
      <div class="not-found__copy">
        <span class="eyebrow eyebrow--center">Page not found</span>
        <p class="not-found__code" aria-hidden="true">404</p>
        <h1>This page wandered <em>off to play.</em></h1>
        <p class="lead">
          We could not find the page you were looking for. It may have moved, or
          the link may be a little out of date. Let’s get you back to somewhere
          useful.
        </p>
        <div class="button-row">
          <a class="btn" href="/">
            Back to home
            <Icon name="arrow" size={15} />
          </a>
          <a class="btn btn--secondary" href="/services/">Browse services</a>
        </div>
        <div class="not-found__links">
          <a href="/about/">About us</a>
          <a href="/summer-program/">Summer 2026</a>
          <a href="/group-therapies/">Group therapy</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>

      <div class="not-found__visual" aria-hidden="true">
        <div class="not-found__frame">
          <img
            src={images.kid.src}
            alt=""
            width="1094"
            height="811"
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="not-found__note">
          <Icon name="sparkle" size={17} />
          Wrong turn. Right place.
        </span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.not-found {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 7rem);
    background: var(--cream);
    overflow: clip;
  }
.not-found__blob {
    width: clamp(340px, 50vw, 760px);
    height: clamp(300px, 42vw, 600px);
    top: -30%;
    right: -10%;
    opacity: 0.6;
  }
.not-found__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
.not-found__copy {
    display: grid;
    justify-items: start;
    gap: 1.05rem;
    max-width: 620px;
  }
.not-found__code {
    color: var(--pink-deep);
    font-family: var(--font-serif);
    font-size: clamp(5rem, 12vw, 10rem);
    font-style: italic;
    line-height: 0.8;
    letter-spacing: -0.05em;
    opacity: 0.22;
  }
.not-found h1 {
    max-width: 15ch;
  }
.not-found h1 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.not-found .lead {
    max-width: 52ch;
  }
.not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-top: 0.7rem;
  }
.not-found__links a {
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(45, 22, 116, 0.2);
    padding-bottom: 0.15rem;
  }
.not-found__links a:hover {
    color: var(--pink-deep);
    border-color: var(--pink-deep);
  }
.not-found__visual {
    position: relative;
    max-width: 390px;
    margin-inline: auto;
    width: 100%;
    isolation: isolate;
  }
.not-found__frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 6px solid var(--cream-light);
    border-radius: 999px 999px 32px 32px;
    background: var(--cream-light);
    box-shadow: var(--shadow);
    transform: rotate(2deg);
  }
.not-found__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 56%;
    transform: scale(1.08);
  }
.not-found__note {
    position: absolute;
    left: -0.8rem;
    bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.9rem;
    border-radius: 14px;
    background: var(--white);
    box-shadow: var(--shadow);
    color: var(--purple);
    font-size: 0.66rem;
    font-weight: 600;
    transform: rotate(-3deg);
  }
.not-found__note :global(svg) {
    color: var(--pink-deep);
  }
:global(.not-found__doodle) {
    opacity: 0.55;
  }
:global(.not-found__doodle--one) {
    width: clamp(50px, 7vw, 90px);
    top: 12%;
    left: 4%;
  }
:global(.not-found__doodle--two) {
    width: clamp(34px, 4.5vw, 58px);
    right: 6%;
    bottom: 12%;
    color: var(--gold);
  }
:global(.not-found__doodle--three) {
    width: clamp(70px, 9vw, 120px);
    left: 2%;
    bottom: 6%;
    color: var(--sage-deep);
    opacity: 0.4;
  }

  @media (max-width: 900px) {
.not-found__inner {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
.not-found__copy {
      justify-items: center;
    }
.not-found h1, .not-found .lead {
      max-width: 26ch;
    }
.not-found .lead {
      max-width: 50ch;
    }
.not-found__links {
      justify-content: center;
    }
.not-found__visual {
      max-width: 330px;
    }
  }

  @media (max-width: 560px) {
.not-found__frame {
      aspect-ratio: 1 / 1.1;
    }
.not-found__note {
      left: 0;
    }
  }
</style>
