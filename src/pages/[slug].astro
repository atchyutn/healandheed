---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtPanel from '../components/ArtPanel.astro';
import CtaBand from '../components/CtaBand.astro';
import ClinicalNote from '../components/ClinicalNote.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { landingPages, landingBySlug, type LandingPage } from '../data/landing';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema, webPageSchema } from '../lib/schema';

export function getStaticPaths() {
  return landingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: LandingPage;
}

const { page } = Astro.props;
const path = `/${page.slug}/`;

const parent =
  page.kind === 'service'
    ? { name: 'Services', path: '/services/' }
    : page.kind === 'condition'
      ? { name: 'Parent guides', path: '/blog/' }
      : { name: 'About us', path: '/about/' };

const relatedPages = page.related
  .map((slug) => landingBySlug.get(slug))
  .filter((item): item is LandingPage => Boolean(item));

const pageSchemas: Record<string, unknown>[] = [
  webPageSchema({
    name: page.title,
    description: page.description,
    path,
    type: page.kind === 'service' ? 'ServicePage' : 'WebPage',
  }),
  faqSchema(page.faqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: parent.name, path: parent.path },
    { name: page.title, path },
  ]),
];

if (page.kind === 'service' && page.serviceName) {
  pageSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.serviceName,
    description: page.description,
    url: new URL(path, site.url).href,
    serviceType: page.serviceName,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'City', name: 'Hyderabad' },
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: new URL('/contact/', site.url).href,
      servicePhone: { '@type': 'ContactPoint', telephone: site.phone },
    },
  });
}
---

<BaseLayout
  title={`${page.title} ${page.accent}`}
  description={page.description}
  jsonLd={pageSchemas}
>
  <PageHero
    eyebrow={page.eyebrow}
    title={page.title}
    accent={page.accent}
    lead={page.lead}
    badge={page.badge}
    breadcrumb={page.breadcrumb}
    imageTone={page.tone === 'plum' ? 'periwinkle' : page.tone}
    compact
  >
    <div class="button-row landing-hero-actions">
      <a class="btn" href="/contact/" data-track="booking">
        {page.ctaLabel}
        <Icon name="arrow" size={15} />
      </a>
      <a class="btn btn--secondary" href={site.phoneHref} data-track="call">
        <Icon name="phone" size={15} />
        Call our team
      </a>
    </div>
    <ArtPanel
      slot="visual"
      layout="orbit"
      tone={page.tone}
      centerIcon={page.icon}
      items={[
        { icon: 'heart' },
        { icon: 'users' },
        { icon: 'sparkle' },
        { icon: 'shield' },
      ]}
      eyebrow={page.kind === 'condition' ? 'Parent guidance' : page.kind === 'team' ? 'Our people' : 'Our therapy'}
      title={page.kind === 'condition' ? 'Clear, honest guidance.' : 'Care that sees the whole child.'}
    />
  </PageHero>

  {page.clinicalReview && (
    <div class="section section--white clinical-band">
      <div class="container">
        <ClinicalNote />
      </div>
    </div>
  )}

  <!-- Overview -->
  <section class="section section--white landing-overview">
    <div class="container landing-overview__inner">
      <div class="landing-overview__copy reveal">
        <span class="eyebrow">At a glance</span>
        <h2>Support built around <em>your child.</em></h2>
        <p class="lead">{page.intro}</p>
        <ul class="check-list landing-highlights">
          {page.highlights.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="landing-overview__aside reveal" style="--reveal-delay:120ms">
        <div class="landing-overview__card">
          <span class="landing-overview__card-icon"><Icon name={page.icon} size={26} /></span>
          <p class="landing-overview__card-kicker">Start with a conversation</p>
          <p class="landing-overview__card-title">Not sure where to begin?</p>
          <p class="landing-overview__card-text">
            Tell us what you have noticed. We will explain the options and help you
            find the right next step — no decision needed today.
          </p>
          <a class="text-link" href="/contact/">
            Talk to our team
            <Icon name="arrow" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail sections -->
  {page.sections.map((section, index) => (
    <section class:list={['section', `section--${section.tone ?? 'blush'}`, 'landing-detail']}>
      <div class="container landing-detail__inner">
        <div class="landing-detail__head reveal">
          <SectionHeading
            eyebrow={section.eyebrow}
            title={section.heading}
            accent={section.accent}
            align="left"
          />
        </div>
        <div class="landing-detail__body reveal" style="--reveal-delay:100ms">
          <p class="lead">{section.body}</p>
          {section.bullets && (
            <ul class="check-list landing-detail__list">
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
          {index === 0 && (
            <a class="btn btn--secondary" href="/contact/" data-track="booking">
              Ask us a question
              <Icon name="arrow" size={14} />
            </a>
          )}
        </div>
      </div>
    </section>
  ))}

  <!-- Process -->
  <section class="section section--periwinkle landing-process">
    <div class="container">
      <SectionHeading
        eyebrow="How it works"
        title="A clear path"
        accent="from day one."
        lead="No jargon, no guesswork. We start by listening, then build a plan with you and keep you involved at every step."
      />
      <div class="landing-process__grid">
        {page.process.map((step, index) => (
          <article class="landing-process__step reveal" style={`--reveal-delay:${index * 60}ms`}>
            <span class="landing-process__number">0{index + 1}</span>
            <span class="landing-process__icon"><Icon name={step.icon} size={20} /></span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="section section--white landing-audience">
    <div class="container landing-audience__inner">
      <div class="landing-audience__visual reveal">
        <ArtPanel
          layout="grid"
          tone="pink"
          items={[
            { icon: 'heart' },
            { icon: 'users' },
            { icon: 'sprout' },
            { icon: 'sparkle' },
          ]}
        />
      </div>
      <div class="landing-audience__copy reveal" style="--reveal-delay:120ms">
        <span class="eyebrow">Is this right for us?</span>
        <h2>Could this help <em>your family?</em></h2>
        <p class="lead">
          If any of these sound familiar, a conversation with our team is a good
          place to start. You do not need to know the answer before you get in touch.
        </p>
        <ul class="check-list check-list--sage">
          {page.whoFor.map((item) => <li>{item}</li>)}
        </ul>
        <a class="btn" href="/contact/" data-track="booking">
          Get in touch
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Internal links -->
  <nav class="section section--blush landing-related" aria-label="Related pages">
    <div class="container">
      <SectionHeading eyebrow="Keep exploring" title="Related" accent="support." />
      <div class="landing-related__grid">
        {relatedPages.map((item) => (
          <a class="landing-related__card reveal" href={`/${item.slug}/`}>
            <span class="landing-related__icon"><Icon name={item.icon} size={19} /></span>
            <span class="landing-related__text">
              <strong>{item.title}</strong>
              <small>{item.lead}</small>
            </span>
            <Icon name="arrow" size={16} />
          </a>
        ))}
        <a class="landing-related__card reveal" href="/services/">
          <span class="landing-related__icon"><Icon name="blocks" size={19} /></span>
          <span class="landing-related__text">
            <strong>All services</strong>
            <small>See the full range of support available in L.B. Nagar.</small>
          </span>
          <Icon name="arrow" size={16} />
        </a>
        <a class="landing-related__card reveal" href="/blog/">
          <span class="landing-related__icon"><Icon name="book" size={19} /></span>
          <span class="landing-related__text">
            <strong>Parent guides</strong>
            <small>Practical articles written for families, reviewed by clinicians.</small>
          </span>
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </nav>

  <!-- FAQ -->
  <section class="section section--white faq-section">
    <div class="container faq-section__inner">
      <div class="faq-section__intro reveal">
        <span class="eyebrow">Good to know</span>
        <h2>Questions <em>parents ask.</em></h2>
        <p class="lead">
          Here are a few things families ask us most often. If your question is not
          here, we are only a call or message away.
        </p>
        <a class="text-link" href="/contact/">
          Ask us something else
          <Icon name="arrow" size={14} />
        </a>
      </div>
      <div class="faq-section__list reveal" style="--reveal-delay:120ms">
        <FaqList items={page.faqs} />
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Ready when you are"
    title="Let’s find the right"
    accent="next step."
    text="Tell us what you have noticed and what you are hoping for. We will listen, explain the options and help you choose a plan that fits your child."
    primaryLabel={page.ctaLabel}
    primaryHref="/contact/"
    secondaryLabel="Call our team"
    secondaryHref={site.phoneHref}
  />
</BaseLayout>

<style>
  .landing-hero-actions { margin-top: 0.4rem; }
  .clinical-band { padding-block: 1.5rem 2.5rem; }

  .landing-overview__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .landing-overview__copy { display: grid; justify-items: start; gap: 1.1rem; }
  .landing-overview__copy h2 em { color: var(--pink-deep); font-style: italic; }
  .landing-overview__copy p:not(.lead) { color: var(--muted); }
  .landing-highlights { margin-top: 0.4rem; }
  .landing-overview__card {
    display: grid;
    justify-items: start;
    gap: 0.65rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg, 24px);
    background: var(--white);
    box-shadow: var(--shadow-sm, var(--shadow));
  }
  .landing-overview__card-icon {
    display: grid; place-items: center;
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--pink-soft); color: var(--pink-deep);
  }
  .landing-overview__card-kicker {
    color: var(--pink-deep); font-size: 0.64rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .landing-overview__card-title {
    color: var(--purple); font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.2;
  }
  .landing-overview__card-text { color: var(--muted); font-size: 0.85rem; line-height: 1.65; }

  .landing-detail__inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .landing-detail__body { display: grid; justify-items: start; gap: 1.1rem; }
  .landing-detail__body .lead { max-width: 60ch; color: var(--ink-soft); }
  .landing-detail__list { width: 100%; margin-top: 0.2rem; }

  .landing-process__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .landing-process__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.2rem, 2.2vw, 1.7rem);
    border-radius: var(--radius, 18px);
    background: rgba(255, 253, 249, 0.66);
  }
  .landing-process__number {
    position: absolute; top: 0.9rem; right: 1rem;
    color: rgba(45, 22, 116, 0.14);
    font-family: var(--font-serif); font-size: 1.9rem; font-style: italic; line-height: 1;
  }
  .landing-process__icon {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 50%;
    background: var(--pink-soft); color: var(--pink-deep);
  }
  .landing-process__step h3 {
    color: var(--purple); font-family: var(--font-sans);
    font-size: 0.85rem; font-weight: 600; line-height: 1.35;
  }
  .landing-process__step p { color: var(--ink-soft); font-size: 0.78rem; line-height: 1.6; }

  .landing-audience__inner {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .landing-audience__visual { max-width: 380px; margin-inline: auto; width: 100%; }
  .landing-audience__copy { display: grid; justify-items: start; gap: 1rem; }
  .landing-audience__copy h2 em { color: var(--pink-deep); font-style: italic; }
  .landing-audience__copy .check-list { margin-block: 0.3rem; }

  .landing-related__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: clamp(1.8rem, 3vw, 2.6rem);
  }
  .landing-related__card {
    display: grid;
    grid-template-columns: 40px 1fr 18px;
    gap: 0.8rem;
    align-items: center;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm, 16px);
    background: var(--white);
    text-decoration: none;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .landing-related__card:hover { transform: translateX(4px); box-shadow: var(--shadow-sm, var(--shadow)); }
  .landing-related__icon {
    display: grid; place-items: center;
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--pink-soft); color: var(--pink-deep);
  }
  .landing-related__text strong { display: block; color: var(--purple); font-size: 0.82rem; font-weight: 600; }
  .landing-related__text small {
    display: block; margin-top: 0.15rem; color: var(--muted);
    font-size: 0.7rem; line-height: 1.45;
    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .landing-related__card > :global(svg:last-child) { color: var(--pink-deep); }

  .faq-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .faq-section__intro { display: grid; justify-items: start; gap: 1rem; align-content: start; }
  .faq-section__intro h2 em { color: var(--pink-deep); font-style: italic; }
  .faq-section__list :global(.faq-list) { margin-inline: 0; }

  @media (max-width: 900px) {
    .landing-overview__inner, .landing-detail__inner, .landing-audience__inner,
    .faq-section__inner { grid-template-columns: 1fr; }
    .landing-process__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .landing-audience__visual { max-width: 320px; }
  }
  @media (max-width: 640px) {
    .landing-related__grid { grid-template-columns: 1fr; }
    .landing-process__grid { grid-template-columns: 1fr; }
  }
</style>
