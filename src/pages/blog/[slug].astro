---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtPanel from '../../components/ArtPanel.astro';
import CtaBand from '../../components/CtaBand.astro';
import ClinicalNote from '../../components/ClinicalNote.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { blogPosts, type BlogPost } from '../../data/blog';
import { landingBySlug } from '../../data/landing';
import { site } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const path = `/blog/${post.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  url: new URL(path, site.url).href,
  datePublished: post.date,
  dateModified: post.dateModified,
  inLanguage: 'en-IN',
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(path, site.url).href },
  about: { '@id': `${site.url}/#organization` },
  articleSection: post.category,
};

const schemas = [
  articleSchema,
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Parent guides', path: '/blog/' },
    { name: post.title, path },
  ]),
];

const related = post.related
  .map((slug) => landingBySlug.get(slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<BaseLayout
  title={post.title}
  description={post.description}
  image="/og-image.png"
  type="article"
  jsonLd={schemas}
>
  <PageHero
    eyebrow={post.category}
    title={post.title.split(':')[0]}
    accent={post.title.includes(':') ? post.title.split(':').slice(1).join(':').trim() : undefined}
    lead={post.excerpt}
    badge={`${post.readMinutes} min read · Reviewed by our clinical team`}
    breadcrumb="Parent guides"
    imageTone={post.tone === 'plum' ? 'periwinkle' : post.tone}
    compact
  >
    <ArtPanel
      slot="visual"
      layout="orbit"
      tone={post.tone}
      centerIcon={post.icon}
      items={[{ icon: 'book' }, { icon: 'heart' }, { icon: 'sprout' }, { icon: 'shield' }]}
      eyebrow="Parent guide"
      title="General information, not a diagnosis."
    />
  </PageHero>

  <div class="section section--white article-disclaimer">
    <div class="container"><ClinicalNote /></div>
  </div>

  <article class="section section--white article">
    <div class="container article__inner">
      <div class="article__body">
        <p class="article__intro lead">{post.intro}</p>
        {post.sections.map((section, index) => (
          <section class="article__section" id={`section-${index + 1}`}>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
            {section.bullets && (
              <ul class="check-list check-list--sage">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            {section.link && (
              <a class="text-link article__inline-link" href={section.link.href}>
                {section.link.label}
                <Icon name="arrow" size={14} />
              </a>
            )}
          </section>
        ))}
      </div>

      <aside class="article__aside">
        <div class="article__card">
          <span class="article__card-icon"><Icon name="sparkle" size={22} /></span>
          <h2>Key takeaways</h2>
          <ul>
            {post.takeaways.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="article__card article__card--cta">
          <h2>Questions about your child?</h2>
          <p>We are here to listen and explain the options — no pressure, no decision needed today.</p>
          <a class="btn" href="/contact/" data-track="booking">
            Talk to our team
            <Icon name="arrow" size={14} />
          </a>
          <a class="text-link" href={site.phoneHref} data-track="call">
            <Icon name="phone" size={13} /> {site.phone}
          </a>
        </div>
      </aside>
    </div>
  </article>

  <nav class="section section--blush article-related" aria-label="Related support">
    <div class="container">
      <h2 class="article-related__title">Related <em>support.</em></h2>
      <div class="article-related__grid">
        {related.map((item) => (
          <a class="article-related__card" href={`/${item.slug}/`}>
            <span><Icon name={item.icon} size={18} /></span>
            <strong>{item.title}</strong>
            <Icon name="arrow" size={15} />
          </a>
        ))}
        <a class="article-related__card" href="/blog/">
          <span><Icon name="book" size={18} /></span>
          <strong>All parent guides</strong>
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </nav>

  <CtaBand
    eyebrow="Ready when you are"
    title="Let’s take the next step,"
    accent="together."
    text="Tell us about your child and what you are looking for. We will listen, answer your questions and help you find the right next step."
    primaryLabel="Book an appointment"
    primaryHref="/contact/"
    secondaryLabel="Call our team"
    secondaryHref={site.phoneHref}
  />
</BaseLayout>

<style>
  .article-disclaimer { padding-block: 1.5rem 2rem; }
  .article { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .article__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .article__body { display: grid; gap: 2.2rem; max-width: 72ch; }
  .article__intro { color: var(--ink-soft); }
  .article__section { display: grid; justify-items: start; gap: 0.9rem; }
  .article__section h2 {
    color: var(--purple); font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.6vw, 2.15rem); line-height: 1.2;
  }
  .article__section p { color: var(--ink-soft); font-size: 0.96rem; line-height: 1.8; }
  .article__section .check-list { width: 100%; margin-block: 0.2rem; }
  .article__inline-link { margin-top: 0.3rem; }
  .article__aside { display: grid; gap: 1rem; position: sticky; top: calc(var(--header-h, 80px) + 2rem); }
  .article__card {
    display: grid; justify-items: start; gap: 0.85rem;
    padding: clamp(1.3rem, 2.4vw, 1.8rem);
    border: 1px solid var(--line); border-radius: var(--radius-lg, 24px);
    background: var(--white);
  }
  .article__card-icon {
    display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--gold-soft); color: #7f5a1f;
  }
  .article__card h2 { color: var(--purple); font-family: var(--font-sans); font-size: 0.95rem; font-weight: 700; }
  .article__card ul { display: grid; gap: 0.7rem; }
  .article__card li {
    position: relative; padding-left: 1.1rem;
    color: var(--ink-soft); font-size: 0.82rem; line-height: 1.55;
  }
  .article__card li::before {
    content: ''; position: absolute; left: 0; top: 0.55rem;
    width: 6px; height: 6px; border-radius: 50%; background: var(--pink-deep);
  }
  .article__card p { color: var(--muted); font-size: 0.82rem; line-height: 1.6; }
  .article__card--cta { background: var(--pink-soft); border-color: transparent; }
  .article-related__title { color: var(--purple); font-size: clamp(1.7rem, 3vw, 2.4rem); text-align: center; }
  .article-related__title em { color: var(--pink-deep); font-style: italic; }
  .article-related__grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem; margin-top: 2rem;
  }
  .article-related__card {
    display: grid; grid-template-columns: 38px 1fr 18px; gap: 0.75rem; align-items: center;
    padding: 0.9rem 1rem; border-radius: var(--radius-sm, 16px);
    background: var(--white); text-decoration: none;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .article-related__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-sm, var(--shadow)); }
  .article-related__card span {
    display: grid; place-items: center; width: 36px; height: 36px;
    border-radius: 50%; background: var(--pink-soft); color: var(--pink-deep);
  }
  .article-related__card strong { color: var(--purple); font-size: 0.8rem; line-height: 1.3; }
  .article-related__card > :global(svg:last-child) { color: var(--pink-deep); }
  @media (max-width: 900px) {
    .article__inner { grid-template-columns: 1fr; }
    .article__aside { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .article-related__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) { .article__aside { grid-template-columns: 1fr; } }
</style>
