---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtPanel from '../components/ArtPanel.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import CtaBand from '../components/CtaBand.astro';
import Doodle from '../components/Doodle.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { images } from '../lib/images';
import { services, careFormats } from '../data/services';
import { approach, ratingOnlyReviews, values, team } from '../data/content';
import { homeFaqs } from '../data/faqs';
import { site, trustPoints } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Heal & Heed — Child Development & Rehabilitation Center',
  description:
    'Compassionate child development and rehabilitation therapy in L.B. Nagar, Hyderabad.',
  url: `${site.url}/`,
  about: { '@id': `${site.url}/#organization` },
  primaryImageOfPage: `${site.url}/og-image.png`,
  inLanguage: 'en-IN',
};
---

<BaseLayout
  title="Child Development & Rehabilitation in Hyderabad"
  description="Compassionate child development and rehabilitation therapy in L.B. Nagar, Hyderabad. Occupational, behaviour, speech therapy and special education."
  jsonLd={[pageSchema, faqSchema]}
>
  <!-- Hero -->
  <section class="home-hero">
    <div class="home-hero__blob home-hero__blob--pink blob"></div>
    <div class="home-hero__blob home-hero__blob--periwinkle blob"></div>
    <Doodle type="butterfly" class="home-hero__doodle home-hero__doodle--butterfly" />
    <Doodle type="sparkle" class="home-hero__doodle home-hero__doodle--sparkle" />
    <Doodle type="flower" class="home-hero__doodle home-hero__doodle--flower" />

    <div class="container home-hero__inner">
      <span class="pill home-hero__eyebrow">
        <span class="pill__dot"></span>
        Child development &amp; rehabilitation · L.B. Nagar
      </span>

      <h1>
        Building brighter futures,<br />
        <em>one step at a time.</em>
      </h1>

      <p class="lead home-hero__lead">
        Compassionate, personalised therapy for children and families in Hyderabad.
        We help little ones grow, communicate and thrive — with care that sees the
        whole child.
      </p>

      <div class="button-row home-hero__actions">
        <a class="btn btn--large" href="/online-sessions/">
          Book an appointment
          <Icon name="arrow" size={16} />
        </a>
        <a class="btn btn--large btn--secondary" href="#services">
          Explore our services
        </a>
      </div>

      <ul class="home-hero__trust" aria-label="Our therapy services">
        {trustPoints.map((point) => (
          <li>
            <Icon name="check" size={13} />
            {point}
          </li>
        ))}
      </ul>

      <div class="hero-gallery" aria-label="A glimpse of Heal and Heed">
        <div class="hero-gallery__ground" aria-hidden="true">
          <svg viewBox="0 0 1440 240" preserveAspectRatio="none">
            <path
              d="M0 118c142-52 259-48 400-9 141 38 240 75 393 35 154-40 231-71 371-40 106 24 183 47 276 20v116H0V118Z"
              fill="var(--rose)"
            />
            <path
              d="M0 160c129-33 245-25 371 10 153 42 253 61 403 25 170-41 274-52 398-17 109 31 185 39 268 20v42H0v-80Z"
              fill="var(--mauve-deep)"
              opacity=".45"
            />
          </svg>
        </div>

        <figure class="hero-card hero-card--one">
          <div class="hero-card__frame">
            <img
              src={images.kid.src}
              alt="Illustration of a child playing with a toy car"
              width="1094"
              height="811"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption><span>01</span> Play</figcaption>
        </figure>

        <figure class="hero-card hero-card--two">
          <div class="hero-card__frame hero-card__frame--icon">
            <span class="hero-card__icon">
              <Icon name="sprout" size={62} strokeWidth={1.25} />
            </span>
            <span class="hero-card__spark" aria-hidden="true"></span>
          </div>
          <figcaption><span>02</span> Grow</figcaption>
        </figure>

        <figure class="hero-card hero-card--three">
          <div class="hero-card__frame">
            <img
              src={images.doctor.src}
              alt="Illustration of a doctor with a heart"
              width="1105"
              height="783"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption><span>03</span> Care</figcaption>
        </figure>

        <figure class="hero-card hero-card--four">
          <div class="hero-card__frame hero-card__frame--icon">
            <span class="hero-card__icon">
              <Icon name="star" size={58} strokeWidth={1.25} />
            </span>
            <span class="hero-card__spark" aria-hidden="true"></span>
          </div>
          <figcaption><span>04</span> Thrive</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <BrandMarquee />

  <!-- Intro -->
  <section class="section section--periwinkle grid-lines intro-section">
    <Doodle type="sun" class="intro-section__doodle intro-section__doodle--sun" />
    <div class="container intro">
      <div class="intro__side intro__side--left">
        <div class="intro__side-bg intro__side-bg--pink"></div>
        <div class="intro__art intro__art--left">
          <ArtPanel
            layout="grid"
            tone="pink"
            items={[
              { icon: 'hands', label: 'OT' },
              { icon: 'brain', label: 'Behaviour' },
              { icon: 'chat', label: 'Speech' },
              { icon: 'book', label: 'Learning' },
            ]}
          />
        </div>
      </div>

      <div class="intro__content reveal">
        <span class="eyebrow eyebrow--center">Who we are</span>
        <h2>Empowering <em>young minds</em></h2>
        <p class="lead">
          We are a team of dedicated professionals committed to compassionate,
          comprehensive care. Our approach is personalised to each child, creating
          a nurturing environment for growth and healing.
        </p>
        <p>
          At Heal &amp; Heed, we see the whole child — not just the challenge in front
          of us. We work alongside families so progress feels possible at home, at
          school and everywhere in between.
        </p>
        <a class="btn" href="/about/">
          Get to know us
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div class="intro__side intro__side--right">
        <div class="intro__side-bg intro__side-bg--periwinkle"></div>
        <div class="intro__art intro__art--right">
          <ArtPanel
            layout="grid"
            tone="periwinkle"
            items={[
              { icon: 'home', label: 'Clinic' },
              { icon: 'video', label: 'Online' },
              { icon: 'heart', label: 'Home' },
              { icon: 'clipboard', label: 'Assess' },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="section section--white mission">
    <div class="container grid-2">
      <div class="mission__copy reveal">
        <span class="eyebrow">Our mission</span>
        <h2>Intervention that fits <em>your child.</em></h2>
        <p class="lead">
          “Heal and Heed” is our guiding principle. Dedicated to holistic child
          development, we offer a unique, parent-friendly approach grounded in
          empathy and integrity.
        </p>
        <p>
          In a world where it is tempting to take shortcuts, we choose the path of
          what is right over what is easy. We live our values rather than just
          voice them — and we build every plan around the child in front of us.
        </p>

        <ul class="check-list mission__list">
          <li>Personalised, goal-led therapy plans</li>
          <li>Parents included in every step</li>
          <li>Evidence-based strategies, delivered with warmth</li>
        </ul>

        <a class="btn" href="/services/">
          Explore our services
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div class="mission__visual reveal" style="--reveal-delay:120ms">
        <div class="media-frame">
          <div class="media-frame__bg media-frame__bg--periwinkle"></div>
          <div class="mission__portrait arch">
            <ArtPanel
              layout="orbit"
              tone="periwinkle"
              centerIcon="heart"
              items={[
                { icon: 'hands' },
                { icon: 'brain' },
                { icon: 'chat' },
                { icon: 'book' },
              ]}
              eyebrow="One connected team"
              title="Four therapies, one plan."
            />
          </div>
          <div class="media-frame__badge">
            <Icon name="heart" size={17} />
            <span>Family-first care</span>
          </div>
        </div>
        <Doodle type="leaf" class="mission__leaf" />
        <Doodle type="sparkle" class="mission__sparkle" />
      </div>
    </div>
  </section>

  <!-- Expert care -->
  <section class="section expert" id="services">
    <div class="expert__blob expert__blob--one blob"></div>
    <div class="expert__blob expert__blob--two blob"></div>
    <div class="container expert__inner">
      <div class="expert__copy reveal">
        <span class="eyebrow">Specialised care</span>
        <h2>Expert care,<br /><em>delivered with heart.</em></h2>
        <p>
          We provide specialised psychological and developmental services for
          children, focusing on comprehensive well-being and practical, adaptive
          strategies for everyday life.
        </p>

        <ul class="expert__services">
          {services.map((service) => (
            <li>
              <span class:list={['expert__service-icon', `expert__service-icon--${service.accent}`]}>
                <Icon name={service.icon} size={17} />
              </span>
              {service.title}
            </li>
          ))}
        </ul>

        <a class="btn" href="/services/">
          See how we help
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div class="expert__visual reveal" style="--reveal-delay:120ms">
        <div class="expert__arch expert__arch--main">
          <ArtPanel
            layout="orbit"
            tone="plum"
            centerIcon="brain"
            items={[
              { icon: 'hands' },
              { icon: 'chat' },
              { icon: 'book' },
              { icon: 'chart' },
            ]}
            badge="Assessment to progress"
          />
        </div>
        <div class="expert__arch expert__arch--small">
          <ArtPanel
            layout="grid"
            tone="pink"
            showLabels={false}
            items={[
              { icon: 'check' },
              { icon: 'home' },
              { icon: 'heart' },
              { icon: 'sparkle' },
            ]}
          />
        </div>
        <div class="expert__note">
          <span class="expert__note-icon"><Icon name="sparkle" size={18} /></span>
          <span>
            <strong>Evidence-based</strong>
            <small>Human-first delivery</small>
          </span>
        </div>
        <Doodle type="butterfly" class="expert__butterfly" />
      </div>
    </div>
  </section>

  <!-- Care formats -->
  <section class="section section--blush section--tight formats">
    <div class="container">
      <div class="formats__head reveal">
        <span class="eyebrow">Care that fits your family</span>
        <h2>Different settings. <em>One consistent team.</em></h2>
      </div>
      <div class="formats__grid">
        {careFormats.map((format) => (
          <article class="format reveal">
            <span class="format__icon"><Icon name={format.icon} size={20} /></span>
            <h3>{format.title}</h3>
            <p>{format.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why families choose us -->
  <section class="section section--lilac why">
    <div class="container grid-2">
      <div class="why__visual reveal">
        <div class="why__blob"></div>
        <div class="why__portrait organic-frame">
          <ArtPanel
            layout="orbit"
            tone="rose"
            centerIcon="home"
            items={[
              { icon: 'heart' },
              { icon: 'users' },
              { icon: 'sun' },
            ]}
            badge="Skills for real life"
          />
        </div>
        <Doodle type="flower" class="why__flower" />
      </div>

      <div class="why__copy reveal" style="--reveal-delay:120ms">
        <span class="eyebrow">Why Heal &amp; Heed</span>
        <h2>Therapy that makes <em>home life easier.</em></h2>
        <p class="lead">
          We do not just work with your child in the session room. We share
          strategies, celebrate wins and help families carry progress into real
          life.
        </p>
        <ul class="check-list why__list">
          <li>A plan that starts with listening, not assumptions</li>
          <li>Therapists who talk to each other and to you</li>
          <li>Practical strategies you can use at home</li>
          <li>Honest, regular reviews of what is working</li>
        </ul>
        <a class="btn" href="/about/">
          Our approach
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Impact -->
  <section class="section section--mauve impact">
    <div class="container impact__inner">
      <div class="impact__copy reveal">
        <span class="eyebrow">Our impact</span>
        <h2>Small steps.<br /><em>Real progress.</em></h2>
        <p class="lead">
          Progress is not always loud. It can be a calmer morning, a first
          sentence, a child asking for help or a parent who finally feels
          understood.
        </p>
        <p>
          We measure what matters to your family — and we keep the child at the
          centre of every decision.
        </p>
        <a class="btn" href="/contact/">
          Start your child’s journey
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div class="impact__stats reveal" style="--reveal-delay:120ms">
        <article class="stat-card">
          <strong>04</strong>
          <span>Core therapy programmes</span>
        </article>
        <article class="stat-card stat-card--pink">
          <strong>04</strong>
          <span>Ways to access support</span>
        </article>
        <article class="stat-card stat-card--periwinkle">
          <strong>2–12</strong>
          <span>Ages in our summer programme</span>
        </article>
        <article class="stat-card stat-card--lilac">
          <strong>01</strong>
          <span>Plan built around your child</span>
        </article>
      </div>

      <div class="impact__visual reveal" style="--reveal-delay:220ms">
        <div class="impact__circle">
          <ArtPanel
            layout="orbit"
            tone="pink"
            centerIcon="chart"
            items={[
              { icon: 'sprout' },
              { icon: 'heart' },
            ]}
          />
        </div>
        <div class="impact__badge">
          <Icon name="sparkle" size={18} />
          <span>Every step<br /><strong>counts</strong></span>
        </div>
        <Doodle type="sun" class="impact__sun" />
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section section--periwinkle-deep team-section" id="team">
    <Doodle type="giraffe" class="team-section__giraffe" />
    <Doodle type="leaf" class="team-section__leaf" />
    <Doodle type="sun" class="team-section__sun" />
    <div class="container team-section__inner">
      <div class="team-section__copy reveal">
        <span class="eyebrow">Meet the team</span>
        <h2>People who listen,<br /><em>then lead.</em></h2>
        <p class="lead">
          Our team brings together occupational therapy, behaviour therapy, speech
          therapy and special education — collaborating so your child receives
          consistent, joined-up support.
        </p>

        <ul class="team-roles">
          {team.map((member) => (
            <li>
              <span class="team-roles__icon"><Icon name={member.icon} size={17} /></span>
              <span>
                <strong>{member.role}</strong>
                <small>{member.text}</small>
              </span>
            </li>
          ))}
        </ul>

        <a class="btn btn--secondary" href="/about/#team">
          Meet the team
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div class="team-section__visual reveal" style="--reveal-delay:140ms">
        <div class="team-section__ring"></div>
        <div class="team-section__portrait">
          <ArtPanel
            layout="orbit"
            tone="rose"
            centerIcon="users"
            items={[
              { icon: 'hands' },
              { icon: 'brain' },
              { icon: 'chat' },
            ]}
          />
        </div>
        <span class="team-section__mascot">
          <Image
            src={images.brainCrown}
            alt=""
            width={180}
            height={180}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </span>
        <div class="team-section__sticker">
          <Icon name="heart" size={18} />
          <span>Care that<br />sees the whole child</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Evidence -->
  <section class="section section--white evidence">
    <div class="container grid-2">
      <div class="evidence__visual reveal">
        <div class="evidence__portrait arch">
          <ArtPanel
            layout="list"
            tone="plum"
            size="lg"
            items={[
              { icon: 'check', label: 'Goals that matter to your family' },
              { icon: 'home', label: 'Strategies for home and school' },
              { icon: 'chart', label: 'Regular review, at your pace' },
            ]}
            eyebrow="Our approach"
            title="A plan that keeps learning."
          />
        </div>
        <span class="evidence__mascot">
          <Image
            src={images.brainWave}
            alt=""
            width={180}
            height={180}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </span>
        <div class="evidence__tag">
          <Icon name="check" size={15} />
          <span>Evidence-based<br /><strong>and human-first</strong></span>
        </div>
        <Doodle type="giraffe" class="evidence__giraffe" />
        <Doodle type="rainbow" class="evidence__rainbow" />
      </div>

      <div class="evidence__copy reveal" style="--reveal-delay:120ms">
        <span class="eyebrow">Our approach</span>
        <h2>Evidence-based therapy.<br /><em>Human-first care.</em></h2>
        <p>
          We use evidence-based strategies to address behavioural, emotional and
          learning challenges, then build customised programmes around each child’s
          unique abilities and goals.
        </p>
        <ul class="check-list check-list--sage">
          <li>Goals that are meaningful to your family</li>
          <li>Strategies that can be used at home and school</li>
          <li>Regular review, so the plan grows with your child</li>
        </ul>
        <a class="btn btn--secondary" href="/services/">
          Explore our approach
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="quote-band">
    <WaveDivider color="var(--white)" />
    <div class="quote-band__inner container">
      <div class="quote-band__faces" aria-hidden="true">
        <span class="quote-band__face quote-band__face--one">
          <Icon name="heart" size={26} strokeWidth={1.4} />
        </span>
        <span class="quote-band__face quote-band__face--two">
          <Icon name="hands" size={26} strokeWidth={1.4} />
        </span>
        <span class="quote-band__face quote-band__face--three">
          <Icon name="sparkle" size={24} strokeWidth={1.4} />
        </span>
      </div>

      <Doodle type="sparkle" class="quote-band__sparkle quote-band__sparkle--one" />
      <Doodle type="star" class="quote-band__sparkle quote-band__sparkle--two" />

      <blockquote>
        “Alone we can do so little;<br />
        <em>together we can do so much.</em>”
      </blockquote>
      <p class="quote-band__cite">— Helen Keller</p>
      <a class="btn btn--ghost" href="/contact/">
        Let’s do this together
        <Icon name="arrow" size={15} />
      </a>
    </div>
    <WaveDivider color="var(--lavender)" flip />
  </section>

  <!-- Approach -->
  <section class="section section--lavender approach-section">
    <div class="container">
      <SectionHeading
        eyebrow="How it works"
        title="A clear path"
        accent="forward."
        lead="No jargon, no guesswork. We start with a conversation and build from there, keeping you involved at every step."
      />

      <div class="approach-grid">
        {approach.map((step, index) => (
          <article
            class:list={['approach-card', `approach-card--tone-${index % 3}`]}
            style={`--reveal-delay:${index * 55}ms`}
          >
            <div class="approach-card__top">
              <span class="approach-card__number">{step.number}</span>
              <span class="approach-card__icon"><Icon name={step.icon} size={20} /></span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>

      <div class="approach-section__cta reveal">
        <p>Most families begin with a simple conversation.</p>
        <a class="btn" href="/online-sessions/">
          Book an appointment
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--rose values">
    <div class="container values__inner">
      <div class="values__intro reveal">
        <span class="eyebrow">Our core values</span>
        <h2>The way we care<br /><em>matters.</em></h2>
        <p class="lead">
          We are guided by a simple belief: every child deserves to be seen,
          heard and supported with integrity.
        </p>
        <p class="values__promise">“Heal with care, heed with heart.”</p>
        <Doodle type="giraffe" class="values__giraffe" />
        <Doodle type="flower" class="values__flower" />
      </div>

      <div class="values__grid">
        {values.map((value, index) => (
          <article class="value-card reveal" style={`--reveal-delay:${index * 70}ms`}>
            <span class="value-card__icon"><Icon name={value.icon} size={20} /></span>
            <h3>{value.title}</h3>
            <p>{value.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--white testimonials">
    <div class="container">
      <SectionHeading
        eyebrow="Parent stories"
        title="Words from"
        accent="our families."
        lead="Real experiences from parents who trusted us with their child’s journey — collected from our Google listing."
      />
      <TestimonialSlider />

      <div class="testimonials__more reveal">
        <p class="testimonials__more-label">
          <span class="testimonials__more-stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <Icon name="star" size={12} />
            ))}
          </span>
          Also rated five stars on Google
        </p>
        <p class="testimonials__more-names">
          {ratingOnlyReviews.slice(0, -1).join(' · ')} · {ratingOnlyReviews.at(-1)}
        </p>
        <a
          class="testimonials__more-link"
          href={site.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read all reviews on Google
          <Icon name="arrow" size={14} />
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section section--petal gallery">
    <div class="container">
      <SectionHeading
        eyebrow="Gallery"
        title="Little moments,"
        accent="big steps."
        lead="A glimpse of the play, patience and progress that fill our days — illustrated with the artwork our families know and love."
      />

      <div class="gallery-grid">
        <figure class="gallery-tile gallery-tile--tall gallery-tile--periwinkle">
          <img
            src={images.kid.src}
            alt="A child playing with a toy car"
            width="1094"
            height="811"
            loading="lazy"
            decoding="async"
          />
          <figcaption><span>Play</span> is how they learn.</figcaption>
        </figure>

        <div class="gallery-tile gallery-tile--quote gallery-tile--lilac">
          <Icon name="sparkle" size={22} />
          <p>“The best progress is the kind you see at home.”</p>
          <span>Our favourite kind of win</span>
        </div>

