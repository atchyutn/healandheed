.team-section__copy h2 em {
    color: var(--purple);
    font-style: italic;
  }
.team-section__copy p {
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
.team-roles {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    margin-block: 0.3rem;
  }
.team-roles li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 0.65rem;
    align-items: start;
    padding: 0.6rem 0.75rem;
    border-radius: 12px;
    background: rgba(255, 253, 249, 0.5);
  }
.team-roles__icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.team-roles strong {
    display: block;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
  }
.team-roles small {
    display: block;
    margin-top: 0.15rem;
    color: rgba(58, 83, 48, 0.72);
    font-size: 0.7rem;
    line-height: 1.55;
  }
.team-section__visual {
    position: relative;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
    isolation: isolate;
    padding-block: 1rem;
  }
.team-section__ring {
    position: absolute;
    inset: 6% 0 10% 0;
    z-index: -1;
    border: 1px dashed rgba(45, 22, 116, 0.22);
    border-radius: 50%;
    transform: rotate(8deg);
  }
.team-section__portrait {
    aspect-ratio: 1 / 1.1;
    overflow: hidden;
    border: 7px solid var(--cream-light);
    border-radius: 48% 52% 45% 55% / 40% 40% 60% 60%;
    background: var(--cream-light);
    box-shadow: var(--shadow);
  }
.team-section__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
.team-section__mascot {
    position: absolute;
    right: -0.25rem;
    bottom: 0.25rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: clamp(116px, 16vw, 158px);
    aspect-ratio: 1;
    padding: 0.55rem 0.55rem 0;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    background: var(--cream-light);
    box-shadow: var(--shadow);
    transform: rotate(3deg);
  }
.team-section__mascot img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
.team-section__sticker {
    position: absolute;
    left: -0.75rem;
    top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.8rem;
    border-radius: 12px;
    background: var(--cream-light);
    box-shadow: var(--shadow-sm);
    color: var(--purple);
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.35;
    transform: rotate(-3deg);
  }
.team-section__sticker :global(svg) {
    color: var(--pink-deep);
  }
:global(.team-section__giraffe) {
    width: clamp(80px, 10vw, 140px);
    right: 2%;
    bottom: 2%;
    color: var(--blue-soft);
    opacity: 0.4;
  }
:global(.team-section__leaf) {
    width: clamp(60px, 8vw, 108px);
    left: 2%;
    bottom: 4%;
    color: var(--sage-deep);
    opacity: 0.35;
  }
:global(.team-section__sun) {
    width: clamp(45px, 6vw, 78px);
    top: 6%;
    left: 44%;
    color: var(--gold);
    opacity: 0.7;
  }
/* Evidence ------------------------------------------- */
  .evidence__visual {
    position: relative;
    max-width: 470px;
    margin-inline: auto;
    width: 100%;
    padding-block: 1rem;
    isolation: isolate;
  }
.evidence__portrait {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    background: var(--cream-light);
    box-shadow: var(--shadow);
  }
.evidence__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 58%;
    transform: scale(1.08);
  }
.evidence__tag {
    position: absolute;
    z-index: 2;
    left: -0.75rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.9rem;
    border-radius: 14px;
    background: var(--white);
    box-shadow: var(--shadow);
    color: var(--purple);
    font-size: 0.65rem;
    line-height: 1.35;
    transform: rotate(-2deg);
  }
.evidence__tag :global(svg) {
    color: var(--pink-deep);
  }
.evidence__tag strong {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-style: italic;
    font-weight: 500;
  }
.evidence__mascot {
    position: absolute;
    z-index: 2;
    right: 0.2rem;
    bottom: 0.2rem;
    display: grid;
    place-items: center;
    width: clamp(88px, 22%, 112px);
    aspect-ratio: 1;
    padding: 0.4rem 0.4rem 0;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    background: var(--cream-light);
    box-shadow: var(--shadow);
    transform: rotate(-3deg);
  }
.evidence__mascot img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
:global(.evidence__giraffe) {
    width: clamp(60px, 8vw, 110px);
    right: -2%;
    top: 3%;
    color: var(--sage-deep);
    opacity: 0.6;
    transform: rotate(8deg);
  }
:global(.evidence__rainbow) {
    width: clamp(55px, 7vw, 100px);
    left: 2%;
    top: 5%;
    color: var(--pink);
    opacity: 0.35;
    transform: rotate(-12deg);
  }
.evidence__copy {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    max-width: 540px;
  }
.evidence__copy h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.evidence__copy p {
    color: var(--muted);
    font-size: 0.94rem;
  }
/* Quote band ----------------------------------------- */
  .quote-band {
    position: relative;
    background: var(--purple);
    color: var(--cream-light);
    text-align: center;
    overflow: clip;
  }
.quote-band > :global(.wave) {
    height: clamp(36px, 5vw, 66px);
  }
.quote-band__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.3rem;
    padding-block: clamp(2.8rem, 6vw, 5.2rem);
  }
.quote-band__faces {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }
.quote-band__face {
    display: grid;
    place-items: center;
    width: clamp(58px, 7vw, 88px);
    aspect-ratio: 1;
    overflow: hidden;
    border: 4px solid var(--purple);
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
    box-shadow: 0 0 0 1px rgba(255, 250, 242, 0.18);
  }
.quote-band__face + .quote-band__face {
    margin-left: -1rem;
  }
.quote-band__face :global(svg) {
    width: 44%;
    height: 44%;
  }
.quote-band__face--two {
    background: var(--lavender);
    color: var(--purple);
  }
.quote-band__face--three {
    background: var(--gold-soft);
    color: #8a5a13;
  }
.quote-band blockquote {
    max-width: 900px;
    color: var(--cream-light);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.8vw, 4.1rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
.quote-band blockquote em {
    color: var(--pink);
    font-style: italic;
  }
.quote-band__cite {
    color: rgba(255, 250, 242, 0.55);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
.quote-band .btn {
    margin-top: 0.5rem;
  }
:global(.quote-band__sparkle) {
    opacity: 0.55;
  }
:global(.quote-band__sparkle--one) {
    width: clamp(35px, 5vw, 64px);
    top: 25%;
    left: 8%;
    color: var(--pink);
  }
:global(.quote-band__sparkle--two) {
    width: clamp(30px, 4vw, 54px);
    bottom: 24%;
    right: 10%;
    color: var(--gold);
  }
/* Approach ------------------------------------------ */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }
.approach-card {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: clamp(1.15rem, 2.2vw, 1.7rem);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--white);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
.approach-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
  }
.approach-card--tone-1 {
    background: var(--blush);
  }
.approach-card--tone-2 {
    background: var(--periwinkle);
    border-color: transparent;
  }
.approach-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.3rem;
  }
.approach-card__number {
    color: var(--pink-deep);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-style: italic;
  }
.approach-card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 253, 249, 0.75);
    color: var(--purple);
  }
.approach-card h3 {
    font-size: 1.25rem;
    line-height: 1.2;
  }
.approach-card p {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }
.approach-section__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
.approach-section__cta p {
    color: var(--muted);
    font-size: 0.82rem;
  }
/* Values -------------------------------------------- */
  .values__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }
.values__intro {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    max-width: 440px;
  }
.values__intro h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
.values__promise {
    margin-top: 0.8rem;
    color: var(--purple);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-style: italic;
    line-height: 1.4;
  }
:global(.values__giraffe) {
    position: relative;
    width: clamp(75px, 10vw, 125px);
    margin-top: 1.5rem;
    color: var(--sage-deep);
    opacity: 0.6;
  }
:global(.values__flower) {
    position: relative;
    width: clamp(44px, 6vw, 72px);
    margin-top: -1rem;
    margin-left: 6rem;
    color: var(--pink-deep);
    opacity: 0.5;
  }
.values__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
.value-card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.15rem, 2.2vw, 1.8rem);
    border-radius: 18px;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
.value-card:nth-child(2n) {
    background: var(--blush);
  }
.value-card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
  }
.value-card h3 {
    font-size: 1.25rem;
  }
.value-card p {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }
/* Gallery ------------------------------------------- */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 210px;
    gap: 0.75rem;
  }
.gallery-tile {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: var(--cream-light);
  }
.gallery-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s var(--ease);
  }
.gallery-tile:hover img {
    transform: scale(1.04);
  }
.gallery-tile figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    right: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: baseline;
    padding: 0.45rem 0.65rem;
    border-radius: 10px;
    background: rgba(255, 253, 249, 0.9);
    color: var(--ink-soft);
    font-size: 0.68rem;
    line-height: 1.4;
  }
.gallery-tile figcaption span {
    color: var(--pink-deep);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
.gallery-tile--tall {
    grid-row: span 2;
  }
.gallery-tile--wide {
    grid-column: span 2;
  }
.gallery-tile--periwinkle {
    background: var(--periwinkle-deep);
  }
.gallery-tile--periwinkle img {
    object-position: 62% 58%;
    transform: scale(1.08);
  }
.gallery-tile--doctor {
    grid-row: span 2;
  }
.gallery-tile--doctor img {
    object-position: 20% 40%;
  }
.gallery-tile--kid-two img {
    object-position: 55% 62%;
    transform: scale(1.1);
  }
.gallery-tile--gold {
    background: var(--gold-soft);
  }
.gallery-tile--icon {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.9), transparent 58%),
      var(--gold-soft);
  }
.gallery-tile--icon.gallery-tile--periwinkle {
    background:
      radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.8), transparent 58%),
      var(--periwinkle-deep);
  }
.gallery-tile__icon {
    display: grid;
    place-items: center;
    width: clamp(84px, 13vw, 126px);
    aspect-ratio: 1;
    border: 5px solid rgba(255, 253, 249, 0.75);
    border-radius: 50%;
    background: var(--cream-light);
    color: #8a5a13;
    box-shadow: 0 22px 38px -22px rgba(45, 22, 116, 0.45);
    transform: translateY(-8%);
  }
.gallery-tile--periwinkle .gallery-tile__icon {
    color: var(--blue-soft);
  }
.gallery-tile--mascot img {
    object-fit: cover;
  }
.gallery-tile--quote {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.55rem;
    padding: clamp(1rem, 2.2vw, 1.6rem);
    color: var(--purple);
  }
.gallery-tile--quote :global(svg) {
    color: var(--pink-deep);
  }
.gallery-tile--quote p {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    font-style: italic;
    line-height: 1.3;
  }
.gallery-tile--quote span {
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }
.gallery-tile--lilac {
    background: var(--lilac);
  }
.gallery-tile--mauve {
    background: var(--mauve);
  }
/* Testimonials --------------------------------------- */
  .testimonials__more {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    max-width: 880px;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding-top: clamp(1.6rem, 3vw, 2.2rem);
    border-top: 1px solid var(--line);
    text-align: center;
  }
.testimonials__more-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--purple);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
.testimonials__more-stars {
    display: inline-flex;
    gap: 0.12rem;
    color: var(--gold);
  }
.testimonials__more-stars :global(svg) {
    fill: currentColor;
  }
.testimonials__more-names {
    max-width: 68ch;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.9;
  }
.testimonials__more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 0.2rem;
    color: var(--purple);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }
.testimonials__more-link:hover {
    color: var(--pink-deep);
    border-color: var(--pink-deep);
  }
/* FAQ ----------------------------------------------- */
  .faq-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
.faq-section__intro {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
.faq-section__intro h2 em {
    color: var(--pink-deep);
    font-style: italic;
  }
/* Responsive ---------------------------------------- */
  @media (max-width: 1100px) {
.intro {
      grid-template-columns: minmax(120px, 0.6fr) minmax(0, 1.6fr) minmax(120px, 0.6fr);
    }
.hero-card__frame {
      height: clamp(145px, 21vw, 250px);
    }
.impact__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  @media (max-width: 980px) {
.expert__inner, .team-section__inner, .evidence .grid-2, .why .grid-2, .mission .grid-2 {
      grid-template-columns: 1fr;
    }
.expert__copy, .team-section__copy, .evidence__copy, .why__copy, .mission__copy {
      max-width: 640px;
    }
.expert__visual {
      max-width: 560px;
      margin-inline: auto;
      width: 100%;
      min-height: 460px;
    }
.formats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
.format:nth-child(2n) {
      border-right: none;
    }
.format:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
.impact__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'visual'
        'stats';
    }
.impact__copy, .impact__stats {
      max-width: 640px;
    }
.impact__visual {
      margin-top: 0.5rem;
    }
.values__inner {
      grid-template-columns: 1fr;
    }
.values__intro {
      max-width: 640px;
    }
:global(.values__giraffe), :global(.values__flower) {
      position: absolute;
      right: 0;
      margin: 0;
    }
:global(.values__giraffe) {
      width: 90px;
      top: auto;
      bottom: 0;
    }
:global(.values__flower) {
      width: 55px;
      right: 6rem;
      bottom: 0.5rem;
    }
.faq-section__inner {
      grid-template-columns: 1fr;
    }
.faq-section__intro {
      position: static;
      max-width: 640px;
    }
.approach-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
.gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 200px;
    }
.gallery-tile--wide {
      grid-column: span 1;
    }
.gallery-tile--tall, .gallery-tile--doctor {
      grid-row: span 1;
    }
  }

  @media (max-width: 760px) {
.evidence__portrait {
      border-radius: 50% 50% var(--radius) var(--radius) / 13% 13% var(--radius) var(--radius);
    }
.intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
.intro__side {
      max-width: 260px;
      margin-inline: auto;
    }
.intro__side--left {
      order: 2;
      margin-top: 1.5rem;
    }
.intro__side--right {
      order: 3;
      margin-top: 1.5rem;
    }
.intro__art {
      max-width: 270px;
    }
.hero-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 520px;
    }
.hero-card--one, .hero-card--two, .hero-card--three, .hero-card--four {
      transform: none;
    }
.hero-card__frame {
      height: clamp(150px, 35vw, 220px);
    }
.hero-gallery__ground {
      height: 84%;
    }
.expert__visual {
      min-height: 420px;
    }
.expert__note {
      right: 0;
      bottom: 4%;
    }
.approach-grid, .formats__grid {
      grid-template-columns: 1fr;
    }
.format {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
.format:last-child {
      border-bottom: none;
    }
.format:nth-child(2n) {
      border-bottom: 1px solid var(--line);
    }
.values__grid {
      grid-template-columns: 1fr;
    }
.quote-band blockquote {
      font-size: clamp(1.9rem, 8vw, 3rem);
    }
:global(.quote-band__sparkle--one), :global(.quote-band__sparkle--two) {
      display: none;
    }
.team-section__sticker {
      left: 0;
    }
  }

  @media (max-width: 380px) {
.evidence__mascot {
      display: none;
    }
.evidence__tag {
      left: 0;
      bottom: -1.25rem;
    }
  }

