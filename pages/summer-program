<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Heal & Heed: Summer Program 2025</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --purple:      #2d1674;
    --purple-deep: #1e0e52;
    --purple-soft: rgba(45,22,116,0.06);
    --purple-mid:  rgba(45,22,116,0.12);
    --pink:        #e36c8a;
    --pink-soft:   rgba(227,108,138,0.10);
    --pink-mid:    rgba(227,108,138,0.18);
    --white:       #ffffff;
    --black:       #000000;
    --text:        #18122e;
    --muted:       #6e6888;
    --border:      rgba(45,22,116,0.11);
    --r:           16px;
    --r-lg:        24px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Sora', sans-serif;
    background: var(--white);
    color: var(--text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  /* ─── HERO ─── */
  .hero { background: var(--purple); position: relative; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 60% 80% at 90% 10%, rgba(227,108,138,0.14) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 10% 80%, rgba(255,255,255,0.04) 0%, transparent 50%);
  }
  .hero-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(255,255,255,0.05); }
  .hero-ring-1 { width: 520px; height: 520px; right: -140px; top: -180px; }
  .hero-ring-2 { width: 320px; height: 320px; right: 30px; top: -60px; }

  .hero-inner {
    position: relative; z-index: 1;
    max-width: 980px; margin: 0 auto;
    padding: 76px 40px 56px;
    display: grid; grid-template-columns: 1fr 200px;
    gap: 48px; align-items: end;
  }
  .hero-kicker {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--pink-mid); border: 1px solid rgba(227,108,138,0.3);
    color: #f0a8bc; font-size: 10.5px; font-weight: 600;
    letter-spacing: 2.5px; text-transform: uppercase;
    padding: 6px 15px; border-radius: 50px; margin-bottom: 22px;
  }
  .hero-kicker-dot { width: 5px; height: 5px; background: var(--pink); border-radius: 50%; }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5.5vw, 62px); font-weight: 900;
    color: var(--white); line-height: 1.08; letter-spacing: -0.5px; margin-bottom: 18px;
  }
  .hero h1 em { font-style: italic; color: var(--pink); }
  .hero-lead {
    font-size: 15.5px; color: rgba(255,255,255,0.58); font-weight: 300;
    max-width: 500px; line-height: 1.8; margin-bottom: 30px;
  }
  .hero-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-tag {
    border: 1px solid rgba(255,255,255,0.16); color: rgba(255,255,255,0.72);
    font-size: 12px; font-weight: 500; padding: 6px 15px; border-radius: 50px;
  }
  .hero-tag.filled { background: var(--pink); border-color: var(--pink); color: #fff; font-weight: 600; }
  .hero-nums { display: flex; flex-direction: column; gap: 18px; align-items: flex-end; padding-bottom: 6px; }
  .hero-num { text-align: right; }
  .hero-num .n { font-family: 'Playfair Display', serif; font-size: 46px; font-weight: 900; color: var(--pink); line-height: 1; }
  .hero-num .l { font-size: 10px; color: rgba(255,255,255,0.35); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }

  .hero-strip {
    position: relative; z-index: 1; max-width: 980px; margin: 0 auto;
    padding: 18px 40px 36px; display: flex; gap: 36px; flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .hs-item .hl { font-size: 9.5px; color: rgba(255,255,255,0.3); letter-spacing: 2.5px; text-transform: uppercase; font-weight: 600; margin-bottom: 3px; }
  .hs-item .hv { font-size: 13.5px; color: rgba(255,255,255,0.78); font-weight: 500; }

  /* ─── PAGE WRAPPER ─── */
  .page { max-width: 980px; margin: 0 auto; padding: 0 40px 80px; }

  /* ─── SECTION HEADER ─── */
  .sh {
    padding: 64px 0 30px; border-bottom: 1px solid var(--border);
    margin-bottom: 36px; display: flex; justify-content: space-between;
    align-items: flex-end; gap: 24px; flex-wrap: wrap;
  }
  .sh-label { font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--pink); margin-bottom: 7px; }
  .sh h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(21px, 3.5vw, 30px); font-weight: 700;
    color: var(--purple); line-height: 1.22; letter-spacing: -0.2px;
  }
  .sh-note { font-size: 13.5px; color: var(--muted); max-width: 280px; text-align: right; line-height: 1.65; }

  /* ─── PULL QUOTE ─── */
  .pull {
    background: var(--purple); border-radius: var(--r-lg);
    padding: 44px 50px; margin: 50px 0; position: relative; overflow: hidden;
  }
  .pull::after {
    content: ''; position: absolute; width: 280px; height: 280px;
    right: -60px; top: -80px;
    background: radial-gradient(circle, rgba(227,108,138,0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .pull q {
    font-family: 'Playfair Display', serif; font-size: clamp(17px, 2.8vw, 22px);
    font-style: italic; color: var(--white); line-height: 1.65; quotes: none;
    display: block; position: relative; z-index: 1; max-width: 700px;
  }
  .pull q strong { font-style: normal; color: var(--pink); }
  .pull-from { margin-top: 16px; font-size: 11px; color: rgba(255,255,255,0.32); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; position: relative; z-index: 1; }

  /* ─── WHAT TO EXPECT ─── */
  .expect {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2px; background: var(--border);
    border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden;
  }
  .exp-cell { background: var(--white); padding: 28px 24px; transition: background 0.18s; cursor: default; }
  .exp-cell:hover { background: var(--purple-soft); }
  .exp-n { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 900; color: var(--pink); opacity: 0.5; line-height: 1; margin-bottom: 12px; }
  .exp-cell h4 { font-size: 13.5px; font-weight: 700; color: var(--purple); margin-bottom: 7px; line-height: 1.35; }
  .exp-cell p { font-size: 12.5px; color: var(--muted); line-height: 1.7; }

  /* ─── SCHEDULE ─── */
  .sched { border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
  .sched-row { display: grid; grid-template-columns: 148px 1fr; border-bottom: 1px solid var(--border); }
  .sched-row:last-child { border-bottom: none; }
  .sched-row:hover .sched-body { background: var(--purple-soft); }
  .sched-time {
    padding: 22px 20px 22px 24px; border-right: 1px solid var(--border);
    display: flex; flex-direction: column; justify-content: center; gap: 3px;
    flex-shrink: 0; background: rgba(45,22,116,0.025);
  }
  .sched-time .st { font-size: 12.5px; font-weight: 700; color: var(--purple); }
  .sched-time .sd { font-size: 11px; color: var(--muted); }
  .sched-body { padding: 22px 24px; transition: background 0.18s; }
  .sched-head { display: flex; align-items: center; gap: 10px; margin-bottom: 5px; flex-wrap: wrap; }
  .sched-title { font-size: 14.5px; font-weight: 700; color: var(--black); }
  .badge { font-size: 9.5px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: 3px 9px; border-radius: 50px; }
  .badge-pink   { background: var(--pink-soft);  color: var(--pink);   }
  .badge-purple { background: var(--purple-soft); color: var(--purple); }
  .sched-desc { font-size: 13px; color: var(--muted); line-height: 1.7; max-width: 560px; }
  .sched-takeaway {
    margin-top: 7px; font-size: 11.5px; font-weight: 600; color: var(--purple);
    display: flex; align-items: center; gap: 7px;
  }
  .sched-takeaway::before { content: ''; width: 16px; height: 2px; background: var(--pink); border-radius: 2px; flex-shrink: 0; }

  /* ─── PRICING ─── */
  .pricing-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 16px; margin-top: 0;
  }
  .price-card {
    border: 1px solid var(--border); border-radius: var(--r-lg);
    overflow: hidden; transition: border-color 0.18s, box-shadow 0.18s;
    cursor: default;
  }
  .price-card:hover { border-color: var(--pink); box-shadow: 0 6px 32px rgba(227,108,138,0.12); }
  .price-card.featured { border-color: var(--purple); border-width: 2px; }
  .price-card.featured:hover { border-color: var(--pink); }
  .price-header { padding: 26px 26px 20px; }
  .price-card.featured .price-header { background: var(--purple); }
  .price-label {
    font-size: 10px; font-weight: 700; letter-spacing: 2.5px;
    text-transform: uppercase; color: var(--pink); margin-bottom: 8px;
  }
  .price-card.featured .price-label { color: rgba(227,108,138,0.8); }
  .price-name {
    font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700;
    color: var(--purple); line-height: 1.25; margin-bottom: 14px;
  }
  .price-card.featured .price-name { color: var(--white); }
  .price-amount {
    display: flex; align-items: baseline; gap: 4px;
  }
  .price-currency { font-size: 18px; font-weight: 700; color: var(--purple); margin-top: 2px; }
  .price-card.featured .price-currency { color: var(--pink); }
  .price-number { font-family: 'Playfair Display', serif; font-size: 42px; font-weight: 900; color: var(--purple); line-height: 1; }
  .price-card.featured .price-number { color: var(--white); }
  .price-per { font-size: 12px; color: var(--muted); font-weight: 400; align-self: flex-end; padding-bottom: 4px; }
  .price-card.featured .price-per { color: rgba(255,255,255,0.45); }
  .price-body { padding: 20px 26px 26px; }
  .price-desc { font-size: 13px; color: var(--muted); line-height: 1.7; margin-bottom: 16px; }
  .price-includes {
    list-style: none; padding: 0;
    font-size: 12.5px; color: var(--muted); line-height: 1.9;
  }
  .price-includes li { display: flex; gap: 8px; align-items: flex-start; }
  .price-includes li::before {
    content: ''; width: 14px; height: 14px; flex-shrink: 0; margin-top: 3px;
    background: var(--pink-soft); border-radius: 50%;
    border: 1.5px solid var(--pink);
    display: flex; align-items: center; justify-content: center;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 10 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4l2.5 2.5L9 1' stroke='%23e36c8a' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-size: 8px 6px; background-position: center; background-repeat: no-repeat;
  }

  /* ─── MONTH JOURNEY ─── */
  .journey {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden;
  }
  .jw { padding: 26px 22px; border-right: 1px solid var(--border); }
  .jw:last-child { border-right: none; }
  .jw:nth-child(odd) { background: var(--purple-soft); }
  .jw-wk { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--pink); margin-bottom: 5px; }
  .jw-theme { font-size: 9.5px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 12px; }
  .jw-title { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 700; color: var(--purple); margin-bottom: 12px; line-height: 1.3; }
  .jw-list { list-style: none; padding: 0; font-size: 12px; color: var(--muted); line-height: 1.9; }
  .jw-list li { display: flex; gap: 7px; align-items: flex-start; }
  .jw-list li::before { content: ''; width: 4px; height: 4px; background: var(--pink); border-radius: 50%; margin-top: 8px; flex-shrink: 0; }
  .jw-act { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border); }
  .jw-act-lbl { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); font-weight: 700; margin-bottom: 5px; }
  .jw-act p { font-size: 11.5px; color: var(--muted); line-height: 1.7; }

  /* ─── CHECKIN STRIP ─── */
  .checkin {
    background: var(--pink); border-radius: var(--r-lg); padding: 38px 46px;
    margin: 48px 0 0; display: grid;
    grid-template-columns: 1fr 1px 1fr 1px 1fr; gap: 28px; align-items: start;
  }
  .ci-item h4 { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 7px; }
  .ci-item p { font-size: 13.5px; color: #fff; line-height: 1.7; font-weight: 400; }
  .ci-div { background: rgba(255,255,255,0.2); }

  /* ─── GAINS ─── */
  .gains {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2px; background: var(--border);
    border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden;
  }
  .gain { background: var(--white); padding: 28px 24px; transition: background 0.18s; cursor: default; }
  .gain:hover { background: var(--purple-soft); }
  .gain .gn { font-family: 'Playfair Display', serif; font-size: 10px; font-weight: 700; color: var(--pink); letter-spacing: 2px; margin-bottom: 9px; }
  .gain h4 { font-size: 13.5px; font-weight: 700; color: var(--purple); margin-bottom: 6px; line-height: 1.3; }
  .gain p  { font-size: 12.5px; color: var(--muted); line-height: 1.7; }

  /* ─── CODING ─── */
  .coding-wrap {
    background: var(--black); border-radius: var(--r-lg); padding: 48px 48px 44px;
    margin-top: 60px; position: relative; overflow: hidden;
  }
  .coding-wrap::before {
    content: ''; position: absolute; width: 440px; height: 440px;
    background: radial-gradient(circle, rgba(45,22,116,0.9) 0%, transparent 65%);
    right: -100px; bottom: -120px; pointer-events: none;
  }
  .coding-wrap::after {
    content: ''; position: absolute; width: 260px; height: 260px;
    background: radial-gradient(circle, rgba(227,108,138,0.12) 0%, transparent 65%);
    left: -40px; top: -40px; pointer-events: none;
  }
  .coding-inner { position: relative; z-index: 1; }
  .coding-wrap .sh-label { color: var(--pink); }
  .coding-wrap h2 {
    font-family: 'Playfair Display', serif; font-size: clamp(22px, 3.5vw, 34px);
    font-weight: 900; color: var(--white); line-height: 1.18;
    letter-spacing: -0.3px; margin-bottom: 12px;
  }
  .coding-wrap h2 em { font-style: italic; color: var(--pink); }
  .coding-lead { font-size: 14.5px; color: rgba(255,255,255,0.45); max-width: 560px; line-height: 1.8; margin-bottom: 36px; font-weight: 300; }
  .prog-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .prog-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.07); border-radius: 13px; padding: 18px; transition: border-color 0.18s; }
  .prog-card:hover { border-color: rgba(227,108,138,0.35); }
  .prog-wk { font-size: 9.5px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--pink); margin-bottom: 7px; }
  .prog-card h4 { font-size: 13.5px; font-weight: 700; color: var(--white); margin-bottom: 10px; line-height: 1.3; }
  .prog-card ul { list-style: none; padding: 0; font-size: 12px; color: rgba(255,255,255,0.45); line-height: 1.9; }
  .prog-card ul li { display: flex; gap: 7px; align-items: flex-start; }
  .prog-card ul li::before { content: ''; width: 3px; height: 3px; background: var(--pink); border-radius: 50%; margin-top: 9px; flex-shrink: 0; }
  .prog-apps { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.07); }
  .prog-app { font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.4); border: 1px solid rgba(255,255,255,0.1); padding: 2px 9px; border-radius: 50px; }
  .coding-note { margin-top: 24px; border-left: 2px solid var(--pink); padding: 14px 18px; background: rgba(255,255,255,0.03); border-radius: 0 10px 10px 0; font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.75; }
  .coding-note strong { color: rgba(255,255,255,0.75); }

  /* ─── FAQ ─── */
  .faq { margin-top: 60px; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 22px 0; }
  .faq-item:first-child { border-top: 1px solid var(--border); }
  .faq-q { font-size: 14.5px; font-weight: 600; color: var(--purple); margin-bottom: 7px; }
  .faq-a { font-size: 13px; color: var(--muted); line-height: 1.75; max-width: 680px; }

  /* ─── CTA ─── */
  .cta-section {
    background: var(--purple); margin-top: 80px; padding: 72px 40px;
    text-align: center; position: relative; overflow: hidden;
  }
  .cta-section::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(227,108,138,0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .cta-section h2 {
    font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 40px);
    font-weight: 900; color: var(--white); margin-bottom: 14px;
    position: relative; line-height: 1.15;
  }
  .cta-section h2 em { font-style: italic; color: var(--pink); }
  .cta-section p {
    font-size: 15px; color: rgba(255,255,255,0.5); margin-bottom: 36px;
    position: relative; font-weight: 300;
    max-width: 440px; margin-left: auto; margin-right: auto; line-height: 1.75;
  }
  .wa-btn {
    display: inline-flex; align-items: center; gap: 11px;
    background: var(--pink); color: #fff;
    font-size: 14px; font-weight: 700; padding: 15px 34px;
    border-radius: 50px; text-decoration: none; position: relative;
    transition: opacity 0.18s, transform 0.18s; letter-spacing: 0.2px;
  }
  .wa-btn:hover { opacity: 0.9; transform: translateY(-2px); }
  .wa-btn svg { width: 20px; height: 20px; flex-shrink: 0; }
  .cta-sub { margin-top: 18px; font-size: 12px; color: rgba(255,255,255,0.25); position: relative; letter-spacing: 0.5px; }

  /* ─── FOOTER ─── */
  .foot { background: var(--purple-deep); padding: 22px 40px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .foot-brand { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 700; color: var(--white); }
  .foot-brand span { color: var(--pink); }
  .foot-copy { font-size: 11.5px; color: rgba(255,255,255,0.22); }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 780px) {
    .hero-inner { grid-template-columns: 1fr; padding: 56px 24px 36px; }
    .hero-nums { flex-direction: row; align-items: flex-start; }
    .hero-num { text-align: left; }
    .hero-strip { padding: 16px 24px 28px; gap: 22px; }
    .page { padding: 0 24px 60px; }
    .expect { grid-template-columns: 1fr 1fr; }
    .journey { grid-template-columns: 1fr 1fr; }
    .jw:nth-child(2) { border-right: none; }
    .jw:nth-child(1), .jw:nth-child(2) { border-bottom: 1px solid var(--border); }
    .checkin { grid-template-columns: 1fr; }
    .ci-div { display: none; }
    .prog-grid { grid-template-columns: 1fr 1fr; }
    .gains { grid-template-columns: 1fr 1fr; }
    .coding-wrap { padding: 30px 24px; }
    .pull { padding: 32px 28px; }
    .sh-note { text-align: left; max-width: 100%; }
    .pricing-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 500px) {
    .expect { grid-template-columns: 1fr; }
    .journey { grid-template-columns: 1fr; }
    .jw { border-right: none; border-bottom: 1px solid var(--border); }
    .prog-grid { grid-template-columns: 1fr; }
    .gains { grid-template-columns: 1fr; }
    .sched-row { grid-template-columns: 1fr; }
    .sched-time { border-right: none; padding: 18px 20px 4px; background: none; }
    .sched-body { padding: 4px 20px 18px; }
    .pricing-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<!-- HERO -->
<header class="hero">
  <div class="hero-bg"></div>
  <div class="hero-ring hero-ring-1"></div>
  <div class="hero-ring hero-ring-2"></div>
  <div class="hero-inner">
    <div>
      <div class="hero-kicker"><div class="hero-kicker-dot"></div> Heal &amp; Heed · Hyderabad · Summer 2025</div>
      <h1>A Summer That<br>Actually <em>Moves<br>Things Forward</em></h1>
      <p class="hero-lead">A structured therapeutic programme for children aged 2–12 that builds communication, independence, and confidence, through routines they actually enjoy.</p>
      <div class="hero-tags">
        <div class="hero-tag filled">Ages 2–12</div>
        <div class="hero-tag">10 AM to 4 PM</div>
        <div class="hero-tag">4 Weeks</div>
        <div class="hero-tag">Coding Add-On Available</div>
      </div>
    </div>
    <div class="hero-nums">
